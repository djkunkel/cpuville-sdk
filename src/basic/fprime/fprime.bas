10 PRINT "MAX NUMBER TO CHECK"
20 INPUT L
30 IF L < 2 THEN END
40 DIM P(3000)
50 PC = 1
60 P(1) = 2
70 PRINT 2;
80 FOR N = 3 TO L STEP 2
90   PRIME = -1
100  FOR I = 2 TO PC
110    D = P(I)
120    IF D * D > N THEN GOTO 160
130    IF N / D = INT(N / D) THEN PRIME = 0: GOTO 170
140  NEXT I
160  PC = PC + 1
165  P(PC) = N
166  PRINT N;
170 NEXT N
180 END