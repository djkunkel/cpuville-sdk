#!/bin/sh
# runmon FILE - load FILE into the Z80 over serial and start it running at
# 0x0800. Performs the full binary-load handshake, sends the bytes, then
# issues "run 0800". For load-without-run, use loadmon; for raw byte send
# only, use sendmon.

set -e

[ $# -eq 1 ] || { printf 'usage: runmon FILE\n' >&2; exit 2; }
[ -f "$1" ] || { printf 'runmon: not a file: %s\n' "$1" >&2; exit 1; }

# Locate the project root (parent of this script's bin/ directory), allowing
# for being invoked via PATH.
_self=$0
case $_self in
  */*) ;;
  *)
    _oldifs=$IFS; IFS=:
    for _d in $PATH; do
      [ -x "${_d:-.}/$_self" ] && { _self=${_d:-.}/$_self; break; }
    done
    IFS=$_oldifs ;;
esac
PROJECT_ROOT=$(cd "$(dirname -- "$_self")/.." && pwd)

SERIAL_DEV=/dev/ttyUSB0
if [ -f "$PROJECT_ROOT/serial.conf" ]; then
  . "$PROJECT_ROOT/serial.conf"
fi

printf 'runmon: %s -> %s\n' "$1" "$SERIAL_DEV" >&2

"$PROJECT_ROOT/bin/loadmon" "$1"

printf 'run\x0d' | tee "$SERIAL_DEV" 1>/dev/null
sleep 2
printf '0800\x0d' | tee "$SERIAL_DEV" 1>/dev/null
