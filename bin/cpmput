#!/bin/sh
# cpmput FILE - send FILE to the Z80 over serial using the XMODEM
# (classic checksum) protocol via sx. The receiver on the Cpuvulle Z80
# must already be waiting for an XMODEM transfer (e.g. an interactive
# CP/M PIP/DDT prompt or a monitor "r" command) before invoking this.
#
# sx auto-negotiates the checksum/CRC variant from the receiver's first
# byte: a NAK requests classic 8-bit checksum blocks, a 'C' requests
# 16-bit CRC blocks. Either is supported.
#
# The serial port is configured to 8N1 raw at BAUD_RATE, matching
# console.sh. SERIAL_DEV and BAUD_RATE are read from serial.conf.

set -e

[ $# -eq 1 ] || { printf 'usage: cpmput FILE\n' >&2; exit 2; }
[ -f "$1" ] || { printf 'cpmput: not a file: %s\n' "$1" >&2; exit 1; }

# Locate the project root (parent of this script's bin/ directory), allowing
# for being invoked via PATH.
_self=$0
case $_self in
  */*) ;;
  *)
    _oldifs=$IFS; IFS=:
    for _d in $PATH; do
      [ -x "${_d:-.}/$_self" ] && { _self=${_d:-.}/$_self; break; }
    done
    IFS=$_oldifs ;;
esac
PROJECT_ROOT=$(cd "$(dirname -- "$_self")/.." && pwd)

SERIAL_DEV=/dev/ttyUSB0
BAUD_RATE=76800
if [ -f "$PROJECT_ROOT/serial.conf" ]; then
  . "$PROJECT_ROOT/serial.conf"
fi

printf 'cpmput: %s -> %s (XMODEM)\n' "$1" "$SERIAL_DEV" >&2

# Configure the serial port for 8N1 raw, no flow control, matching
# console.sh. stty is idempotent and safe to re-run on every invocation.
stty -F "$SERIAL_DEV" "$BAUD_RATE" raw -echo -echoe -echok -echoctl -echoke \
  cs8 -cstopb -parenb -ixon -ixoff

# sx reads the receiver's handshake bytes from its stdin and writes the
# XMODEM frames to its stdout. Wire both to the serial device. Classic
# checksum mode is the default; sx falls back to it if the receiver sends
# NAK rather than 'C'.
sx "$1" < "$SERIAL_DEV" > "$SERIAL_DEV"
