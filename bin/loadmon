#!/bin/sh
# loadmon FILE - load FILE into the Z80 over serial using the monitor's
# binary-load protocol (bload, address 0x0800, length, then the bytes).
# This is runmon without the trailing "run" step. To also start execution,
# use runmon. To send only the raw bytes (no handshake), use sendmon.

set -e

[ $# -eq 1 ] || { printf 'usage: loadmon FILE\n' >&2; exit 2; }
[ -f "$1" ] || { printf 'loadmon: not a file: %s\n' "$1" >&2; exit 1; }

# Locate the project root (parent of this script's bin/ directory), allowing
# for being invoked via PATH.
_self=$0
case $_self in
  */*) ;;
  *)
    _oldifs=$IFS; IFS=:
    for _d in $PATH; do
      [ -x "${_d:-.}/$_self" ] && { _self=${_d:-.}/$_self; break; }
    done
    IFS=$_oldifs ;;
esac
PROJECT_ROOT=$(cd "$(dirname -- "$_self")/.." && pwd)

SERIAL_DEV=/dev/ttyUSB0
if [ -f "$PROJECT_ROOT/serial.conf" ]; then
  . "$PROJECT_ROOT/serial.conf"
fi

FILELEN=$(stat -c%s "$1")
printf 'loadmon: %s (%s bytes) -> %s\n' "$1" "$FILELEN" "$SERIAL_DEV" >&2

printf 'bload\x0d' | tee "$SERIAL_DEV" 1>/dev/null
sleep 1
printf '0800\x0d' | tee "$SERIAL_DEV" 1>/dev/null
sleep 1
printf '%s\x0d' "$FILELEN" | tee "$SERIAL_DEV" 1>/dev/null
sleep 1

"$PROJECT_ROOT/bin/sendmon" "$1"

sleep 2
