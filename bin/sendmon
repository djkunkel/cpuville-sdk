#!/bin/sh
# sendmon FILE - send the raw bytes of FILE to the Z80 monitor's serial
# device. Use this when the monitor is already primed to receive a binary
# transfer (you've answered the bload/address/length prompts by hand or via
# loadmon). For the full handshake + run, use runmon; for the handshake
# without run, use loadmon.

set -e

[ $# -eq 1 ] || { printf 'usage: sendmon FILE\n' >&2; exit 2; }
[ -f "$1" ] || { printf 'sendmon: not a file: %s\n' "$1" >&2; exit 1; }

# Locate the project root (parent of this script's bin/ directory), allowing
# for being invoked via PATH.
_self=$0
case $_self in
  */*) ;;
  *)
    _oldifs=$IFS; IFS=:
    for _d in $PATH; do
      [ -x "${_d:-.}/$_self" ] && { _self=${_d:-.}/$_self; break; }
    done
    IFS=$_oldifs ;;
esac
PROJECT_ROOT=$(cd "$(dirname -- "$_self")/.." && pwd)

SERIAL_DEV=/dev/ttyUSB0
if [ -f "$PROJECT_ROOT/serial.conf" ]; then
  . "$PROJECT_ROOT/serial.conf"
fi

printf 'sendmon: %s -> %s\n' "$1" "$SERIAL_DEV" >&2
cat "$1" | tee "$SERIAL_DEV" 1>/dev/null
