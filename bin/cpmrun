#!/bin/sh
# cpmrun PROGRAM [INPUT...] - run a CP/M .COM file under tnylpo with
# optional piped input, for testing before transferring to the Z80.
#
# Usage:
#   cpmrun hello.com
#   cpmrun fprime.com 30
#   echo "30" | cpmrun fprime.com
#
# tnylpo runs .COM files directly (no CCP, no disk images) and exits
# cleanly when the program finishes. The -b flag selects line-mode
# console so output goes to stdout and input is read from stdin.
#
# Any INPUT arguments are fed as lines to the program's stdin, followed
# by piped stdin if present.
#
# Note: programs that poll for console status (e.g. z88dk's getk() for
# CTRL-C handling) will see "input ready" whenever piped data is
# available, which can consume bytes meant for scanf. Test such programs
# interactively (without a pipe) or without the polling check.

set -e

[ $# -ge 1 ] || { printf 'usage: cpmrun PROGRAM [INPUT...]\n' >&2; exit 2; }

prog=$1; shift
case "$prog" in
  *.com|*.COM) ;;
  *) prog=$prog.com ;;
esac
[ -f "$prog" ] || { printf 'cpmrun: not a file: %s\n' "$prog" >&2; exit 1; }

# Locate the project root (parent of this script's bin/ directory).
_self=$0
case $_self in
  */*) ;;
  *)
    _oldifs=$IFS; IFS=:
    for _d in $PATH; do
      [ -x "${_d:-.}/$_self" ] && { _self=${_d:-.}/$_self; break; }
    done
    IFS=$_oldifs ;;
esac
PROJECT_ROOT=$(cd "$(dirname -- "$_self")/.." && pwd)
BIN_DIR="$PROJECT_ROOT/bin"

# tnylpo requires the command basename to be lowercase (CP/M convention
# enforced on case-sensitive filesystems). Copy to a temp dir with a
# lowercase name to satisfy this check.
base=$(basename "$prog")
lcase=$(printf '%s' "$base" | tr 'A-Z' 'a-z')
tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT
cp -f "$prog" "$tmpdir/$lcase"

# Feed any args as lines, then piped stdin if present.
if [ $# -gt 0 ] || [ ! -t 0 ]; then
  {
    for arg in "$@"; do
      printf '%s\n' "$arg"
    done
    if [ ! -t 0 ]; then
      cat
    fi
  } | "$BIN_DIR/tnylpo" -b "$tmpdir/$lcase" 2>&1
else
  "$BIN_DIR/tnylpo" -b "$tmpdir/$lcase" 2>&1
fi
