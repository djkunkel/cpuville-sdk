#!/bin/sh
# cpmget FILE - receive a file from the Z80 over serial using the XMODEM
# (classic checksum) protocol via rx. The sender on the Cpuvulle Z80
# (e.g. PCPUT) must already be running and waiting for the initial NAK
# handshake byte before invoking this.
#
# rx -X uses the XMODEM protocol. Without -c, it sends NAK to request
# classic 8-bit checksum mode (matching pcput.asm's default path). The
# sender (pcput.asm) also accepts 'C' for CRC mode, so this interops
# with either variant, but we default to checksum for compatibility
# with the original Christenson protocol.
#
# The serial port is configured to 8N1 raw at BAUD_RATE, matching
# console.sh. SERIAL_DEV and BAUD_RATE are read from serial.conf.

set -e

[ $# -eq 1 ] || { printf 'usage: cpmget FILE\n' >&2; exit 2; }

# Locate the project root (parent of this script's bin/ directory), allowing
# for being invoked via PATH.
_self=$0
case $_self in
  */*) ;;
  *)
    _oldifs=$IFS; IFS=:
    for _d in $PATH; do
      [ -x "${_d:-.}/$_self" ] && { _self=${_d:-.}/$_self; break; }
    done
    IFS=$_oldifs ;;
esac
PROJECT_ROOT=$(cd "$(dirname -- "$_self")/.." && pwd)

SERIAL_DEV=/dev/ttyUSB0
BAUD_RATE=76800
if [ -f "$PROJECT_ROOT/serial.conf" ]; then
  . "$PROJECT_ROOT/serial.conf"
fi

printf 'cpmget: %s <- %s (XMODEM)\n' "$1" "$SERIAL_DEV" >&2

# Configure the serial port for 8N1 raw, no flow control, matching
# console.sh. stty is idempotent and safe to re-run on every invocation.
stty -F "$SERIAL_DEV" "$BAUD_RATE" raw -echo -echoe -echok -echoctl -echoke \
  cs8 -cstopb -parenb -ixon -ixoff

# rx -X receives a single file via XMODEM. Without -c it sends NAK to
# request classic checksum mode. -y overwrites any existing local file
# with the same name. stdin/stdout are wired to the serial device so rx
# can read the sender's frames and write back ACK/NAK handshakes.
rx -X -y "$1" < "$SERIAL_DEV" > "$SERIAL_DEV"
