#!/bin/sh
# cpmget [-v] FILE - receive a file from the Z80 over serial using the
# XMODEM (classic checksum) protocol. The sender on the Cpuvulle Z80
# (e.g. PCPUT) must already be running and waiting for the initial NAK
# handshake byte before invoking this.
#
# Options:
#   -v, --verbose, -t, --trace   log every byte transfer in hex to stderr
#
# The receiver is bin/xmodem-recv, a Python implementation that mirrors
# pcput.asm's protocol exactly, including proper EOT acknowledgement
# (which lrzsz's rx -X mishandles on this version).
#
# The serial port is configured to 8N1 raw at BAUD_RATE, matching
# console.sh. SERIAL_DEV and BAUD_RATE are read from serial.conf.

set -e

verbose=0
while [ $# -gt 0 ]; do
  case "$1" in
    -v|--verbose|-t|--trace) verbose=1; shift ;;
    --) shift; break ;;
    -*) printf 'cpmget: unknown option: %s\n' "$1" >&2; exit 2 ;;
    *) break ;;
  esac
done

[ $# -eq 1 ] || { printf 'usage: cpmget [-v] FILE\n' >&2; exit 2; }

# Locate the project root (parent of this script's bin/ directory), allowing
# for being invoked via PATH.
_self=$0
case $_self in
  */*) ;;
  *)
    _oldifs=$IFS; IFS=:
    for _d in $PATH; do
      [ -x "${_d:-.}/$_self" ] && { _self=${_d:-.}/$_self; break; }
    done
    IFS=$_oldifs ;;
esac
PROJECT_ROOT=$(cd "$(dirname -- "$_self")/.." && pwd)

SERIAL_DEV=/dev/ttyUSB0
BAUD_RATE=76800
if [ -f "$PROJECT_ROOT/serial.conf" ]; then
  . "$PROJECT_ROOT/serial.conf"
fi

printf 'cpmget: %s <- %s (XMODEM)\n' "$1" "$SERIAL_DEV" >&2

# Configure the serial port for 8N1 raw, no flow control, matching
# console.sh. stty is idempotent and safe to re-run on every invocation.
stty -F "$SERIAL_DEV" "$BAUD_RATE" raw -echo -echoe -echok -echoctl -echoke \
  cs8 -cstopb -parenb -ixon -ixoff

# xmodem-recv mirrors pcput.asm's XMODEM protocol exactly: NAK to start,
# receive SOH/seq/~seq/128-byte/checksum frames, ACK good blocks, and
# properly ACK the EOT to complete the transfer. -v enables hex tracing.
if [ "$verbose" = 1 ]; then
  printf 'cpmget: verbose tracing enabled\n' >&2
  _xm_opts="-v"
else
  _xm_opts=""
fi
exec "$PROJECT_ROOT/bin/xmodem-recv" $_xm_opts "$SERIAL_DEV" "$1"
