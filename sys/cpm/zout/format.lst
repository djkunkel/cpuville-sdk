   1:				;Formats four CP/M disks
   2:				;Updated June 2019 to match improved z80_cbios3
   3:				;Writes E5h to 128 sectors on tracks 1 to 255 of each disk (track 0 for system).
   4:				;Uses calls to cbios, in memory at FA00h
   5:				
   6:				;updated by DJ for 8 disk setup, and only clearning the needed sectors on each disk
   7:				
   8:				;since we have 256 director entries of 32 bytes each, we only need to clear
   9:				;the first (256*32)/128(sector size) = 64 sectors of the second track (first track reserved)
  10:				
  11:				include locations.asm
**** locations.asm ****
   1:				;stores the locations in memory that the OS components will live at
   2:				
   3:				;we can use this unless any changes are made to the ccp or bdos that affect its length
   4:				;the bios can grow unless it exceeds putsys.asm's ability to save it as it only saves 6400 bytes right now
   5:				
   6:				
   7:     -	E000          	org_ccp:    equ     $E000
   8:     -	E806          	org_bdos:   equ     org_ccp+$806
   9:     -	F600          	org_bios:   equ     org_ccp+$1600
  10:				
**** format.asm ****
  12:				
  13:     -	F61B          	seldsk:		equ org_bios+(3*9);equ	$F7A5 		;pass disk no. in c
  14:     -	F624          	setdma:		equ org_bios+(3*12);equ	$F7CF  	;pass address in bc
  15:     -	F61E          	settrk:		equ org_bios+(3*10);equ	$F7BE		;pass track in reg C
  16:     -	F621          	setsec:		equ org_bios+(3*11);		;pass sector in reg c
  17:     -	F62A          	write:		equ org_bios+(3*14);equ	$F839		;write one CP/M sector to disk
  18:     -	F633          	prmsg:		equ org_bios+(3*17);equ	0f7d9h		;subroutine to write message (nonstandard)
  19:     -	F60C          	conout:		equ org_bios+(3*4);equ	0f78dh		;print a character
  20:				
  21:				;rom routines
  22:     -	046F          	monitor_warm_start:	equ	046fh
  23:				
  24:				;constants
  25:     -	0008          	num_disks: 			equ 8
  26:     -	0100          	num_entries:		equ 256
  27:     -	0080          	sec_per_track:		equ 128
  28:     -	003F          	sectors:			equ ((num_entries*32)/128)-1
  29:				
  30:				
  31:     -	0800          			org	0800h
  32:    0+20	0800  ED738408			ld (old_stack), sp
  33:   20+10	0804  312609  			ld	sp,format_stack
  34:   30+10	0807  217108  			ld	hl,format_string
  35:   40+17	080A  CD33F6  			call	prmsg
  36:   57+7	080D  3E00    			ld	a,00h		;starting disk
  37:   64+13	080F  326C08  			ld	(disk),a
  38:   77+4	0812  4F      	disk_loop:	ld	c,a		;CP/M disk a
  39:   81+17	0813  CD1BF6  			call	seldsk
  40:				
  41:						;print disk letter
  42:   98+13	0816  3A6C08  			ld a, (disk)
  43:  111+7	0819  C641    			add $41 ; ascii A
  44:  118+4	081B  4F      			ld c, a
  45:  122+17	081C  CD0CF6  			call conout
  46:				
  47:  139+7	081F  3E01    			ld	a,1		;starting track (offset = 1)
  48:  146+13	0821  326E08  			ld	(track),a
  49:  159+7	0824  3E00    	track_loop:	ld	a,0		;starting sector
  50:  166+13	0826  326D08  			ld	(sector),a
  51:  179+10	0829  218608  			ld	hl,directory_sector	;address of data to write
  52:  189+16	082C  226F08  			ld	(address),hl
  53:  205+13	082F  3A6E08  			ld	a,(track)
  54:  218+4	0832  4F      			ld	c,a		;CP/M track
  55:  222+17	0833  CD1EF6  			call	settrk
  56:  239+13	0836  3A6D08  	sector_loop:	ld	a,(sector)
  57:  252+4	0839  4F      			ld	c,a		;CP/M sector
  58:  256+17	083A  CD21F6  			call	setsec
  59:  273+20	083D  ED4B6F08			ld	bc,(address)	;memory location
  60:  293+17	0841  CD24F6  			call	setdma
  61:  310+17	0844  CD2AF6  			call	write
  62:  327+13	0847  3A6D08  			ld	a,(sector)
  63:  340+7	084A  FE3F    			cp	sectors ; only need to do first 64 sectors of this disk
  64:  347+10	084C  CA5608  			jp	z,next_disk
  65:  357+4	084F  3C      			inc	a
  66:  361+13	0850  326D08  			ld	(sector),a
  67:  374+10	0853  C33608  			jp	sector_loop
  68:  384+13	0856  3A6C08  	next_disk:	ld	a,(disk)
  69:  397+4	0859  3C      			inc	a
  70:  401+7	085A  FE08    			cp	num_disks
  71:  408+10	085C  CA6508  			jp	z,done
  72:  418+13	085F  326C08  			ld	(disk),a
  73:  431+10	0862  C31208  			jp	disk_loop
  74:  441+20	0865  ED7B8408	done:	ld sp, (old_stack)
  75:  461+10	0869  C36F04  			jp	monitor_warm_start
  76:				
