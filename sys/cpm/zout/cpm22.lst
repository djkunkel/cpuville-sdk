3207:	F34E  2E03    		LD	L,3		;prepare for error.
3208:	F350  3A45EB  		LD	A,(STATUS)
3209:	F353  3C      		INC	A
3210:	F354  CA84F3  		JP	Z,POSITN4	;close error.
