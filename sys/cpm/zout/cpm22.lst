1162:	E740  118100  		LD	DE,TBUFF+1	;data gets put here.
1163:	E743  7E      	UNKWN7:	LD	A,(HL)		;move it now.
1164:	E744  12      		LD	(DE),A
1165:	E745  B7      		OR	A
1166:	E746  CA4FE7  		JP	Z,UNKWN8
1167:	E749  04      		INC	B
