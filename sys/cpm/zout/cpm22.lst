1397:	E94B  B7      		OR	A		;anything and we won't generate output.
1398:	E94C  C262E9  		JP	NZ,OUTCHR1
1399:	E94F  C5      		PUSH	BC
1400:	E950  CD23E9  		CALL	CKCONSOL	;check console (we don't care whats there).
1401:	E953  C1      		POP	BC
1402:	E954  C5      		PUSH	BC
1403:	E955  CD0CF6  		CALL	CONOUT		;output (C) to the screen.
1404:	E958  C1      		POP	BC
1405:	E959  C5      		PUSH	BC
1406:	E95A  3A0DEB  		LD	A,(PRTFLAG)	;check printer flip-flop flag.
1407:	E95D  B7      		OR	A
1408:	E95E  C40FF6  		CALL	NZ,LIST		;print it also if non-zero.
1409:	E961  C1      		POP	BC
1410:	E962  79      	OUTCHR1:LD	A,C		;update cursors position.
1411:	E963  210CEB  		LD	HL,CURPOS
1412:	E966  FE7F    		CP	DEL		;rubouts don't do anything here.
1413:	E968  C8      		RET	Z
1414:	E969  34      		INC	(HL)		;bump line pointer.
1415:	E96A  FE20    		CP	' '		;and return if a normal character.
1416:	E96C  D0      		RET	NC
1417:	E96D  35      		DEC	(HL)		;restore and check for the start of the line.
1418:	E96E  7E      		LD	A,(HL)
1419:	E96F  B7      		OR	A
1420:	E970  C8      		RET	Z		;ingnore control characters at the start of the line.
1421:	E971  79      		LD	A,C
1422:	E972  FE08    		CP	BS		;is it a backspace?
1423:	E974  C279E9  		JP	NZ,OUTCHR2
1424:	E977  35      		DEC	(HL)		;yes, backup pointer.
1425:	E978  C9      		RET	
1426:	E979  FE0A    	OUTCHR2:CP	LF		;is it a line feed?
1427:	E97B  C0      		RET	NZ		;ignore anything else.
1428:	E97C  3600    		LD	(HL),0		;reset pointer to start of line.
1429:	E97E  C9      		RET	
1430:			;
1431:			;   Output (A) to the screen. If it is a control character
1432:			; (other than carriage control), use ^x format.
1433:			;
1434:	E97F  79      	SHOWIT:	LD	A,C
1435:	E980  CD14E9  		CALL	CHKCHAR		;check character.
1436:	E983  D290E9  		JP	NC,OUTCON	;not a control, use normal output.
1437:	E986  F5      		PUSH	AF
1438:	E987  0E5E    		LD	C,'^'		;for a control character, preceed it with '^'.
1439:	E989  CD48E9  		CALL	OUTCHAR
1440:	E98C  F1      		POP	AF
1441:	E98D  F640    		OR	'@'		;and then use the letter equivelant.
1442:	E98F  4F      		LD	C,A
1443:			;
1444:			;   Function to output (C) to the console device and expand tabs
1445:			; if necessary.
1446:			;
1447:	E990  79      	OUTCON:	LD	A,C
1448:	E991  FE09    		CP	TAB		;is it a tab?
1449:	E993  C248E9  		JP	NZ,OUTCHAR	;use regular output.
1450:	E996  0E20    	OUTCON1:LD	C,' '		;yes it is, use spaces instead.
1451:	E998  CD48E9  		CALL	OUTCHAR
1452:	E99B  3A0CEB  		LD	A,(CURPOS)	;go until the cursor is at a multiple of 8
1453:			
1454:	E99E  E607    		AND	07H		;position.
1455:	E9A0  C296E9  		JP	NZ,OUTCON1
1456:	E9A3  C9      		RET	
1457:			;
1458:			;   Echo a backspace character. Erase the prevoius character
1459:			; on the screen.
1460:			;
1461:	E9A4  CDACE9  	BACKUP:	CALL	BACKUP1		;backup the screen 1 place.
