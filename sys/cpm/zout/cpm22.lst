1312:	E8B7  C30000  		JP	0		;always reboot on these errors.
1313:			;
1314:	E8BA  42646F73	BDOSERR:DEFB	'Bdos Err On '
	      20457272
	      204F6E20
1315:	E8C6  203A2024	BDOSDRV:DEFB	' : $'
1316:	E8CA  42616420	BADSEC:	DEFB	'Bad Sector$'
	      53656374
	      6F7224
1317:	E8D5  53656C65	BADSEL:	DEFB	'Select$'
	      637424
