1240:			;
1241:	E806  C311E8  	FBASE:	JP	FBASE1
1242:			;
1243:			;   Bdos error table.
1244:			;
1245:	E809  99E8    	BADSCTR:DEFW	ERROR1		;bad sector on read or write.
1246:	E80B  A5E8    	BADSLCT:DEFW	ERROR2		;bad disk select.
1247:	E80D  ABE8    	RODISK:	DEFW	ERROR3		;disk is read only.
1248:	E80F  B1E8    	ROFILE:	DEFW	ERROR4		;file is read only.
1249:			;
1250:			;   Entry into bdos. (DE) or (E) are the parameters passed. The
1251:			; function number desired is in register (C).
1252:			;
1253:	E811  EB      	FBASE1:	EX	DE,HL		;save the (DE) parameters.
1254:	E812  2243EB  		LD	(PARAMS),HL
1255:	E815  EB      		EX	DE,HL
1256:	E816  7B      		LD	A,E		;and save register (E) in particular.
1257:	E817  32D6F5  		LD	(EPARAM),A
1258:	E81A  210000  		LD	HL,0
1259:	E81D  2245EB  		LD	(STATUS),HL	;clear return status.
1260:	E820  39      		ADD	HL,SP
1261:	E821  220FEB  		LD	(USRSTACK),HL	;save users stack pointer.
1262:	E824  3141EB  		LD	SP,STKAREA	;and set our own.
1263:	E827  AF      		XOR	A		;clear auto select storage space.
1264:	E828  32E0F5  		LD	(AUTOFLAG),A
1265:	E82B  32DEF5  		LD	(AUTO),A
1266:	E82E  2174F5  		LD	HL,GOBACK	;set return address.
1267:	E831  E5      		PUSH	HL
1268:	E832  79      		LD	A,C		;get function number.
1269:	E833  FE29    		CP	NFUNCTS		;valid function number?
1270:	E835  D0      		RET	NC
1271:	E836  4B      		LD	C,E		;keep single register function here.
1272:	E837  2147E8  		LD	HL,FUNCTNS	;now look thru the function table.
1273:	E83A  5F      		LD	E,A
1274:	E83B  1600    		LD	D,0		;(DE)=function number.
1275:	E83D  19      		ADD	HL,DE
1276:	E83E  19      		ADD	HL,DE		;(HL)=(start of table)+2*(function number).
1277:	E83F  5E      		LD	E,(HL)
1278:	E840  23      		INC	HL
1279:	E841  56      		LD	D,(HL)		;now (DE)=address for this function.
1280:	E842  2A43EB  		LD	HL,(PARAMS)	;retrieve parameters.
1281:	E845  EB      		EX	DE,HL		;now (DE) has the original parameters.
1282:	E846  E9      		JP	(HL)		;execute desired function.
1283:			;
1284:			;   BDOS function jump table.
