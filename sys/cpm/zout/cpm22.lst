1992:			;
1993:			;   Save current file data from fcb.
1994:			;
1995:	ECBB  CDAEEC  	STRDATA:CALL	SETHLDE
1996:	ECBE  7E      		LD	A,(HL)		;get and store record count byte.
1997:	ECBF  32E3F5  		LD	(SAVNREC),A
1998:	ECC2  EB      		EX	DE,HL
1999:	ECC3  7E      		LD	A,(HL)		;get and store next record number byte.
2000:	ECC4  32E1F5  		LD	(SAVNXT),A
