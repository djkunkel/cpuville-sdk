2154:	ED7B  F680    		OR	80H		;and set bit 7.
2155:	ED7D  77      		LD	(HL),A		;then store.
2156:	ED7E  C9      		RET	
2157:			;
2158:			;   Compare (FILEPOS) with (SCRATCH1) and set flags based on
2159:			; the difference. This checks to see if there are more file
2160:			; names in the directory. We are at (FILEPOS) and there are
2161:			; (SCRATCH1) of them to check.
2162:			;
2163:	ED7F  2AEAF5  	MOREFLS:LD	HL,(FILEPOS)	;we are here.
2164:	ED82  EB      		EX	DE,HL
2165:	ED83  2AB3F5  		LD	HL,(SCRATCH1)	;and don't go past here.
2166:	ED86  7B      		LD	A,E		;compute difference but don't keep.
2167:	ED87  96      		SUB	(HL)
2168:	ED88  23      		INC	HL
2169:	ED89  7A      		LD	A,D
2170:	ED8A  9E      		SBC	A,(HL)		;set carry if no more names.
2171:	ED8B  C9      		RET	
2172:			;
2173:			;   Call this routine to prevent (SCRATCH1) from being greater
2174:			; than (FILEPOS).
2175:			;
2176:	ED8C  CD7FED  	CHKNMBR:CALL	MOREFLS		;SCRATCH1 too big?
2177:	ED8F  D8      		RET	C
2178:	ED90  13      		INC	DE		;yes, reset it to (FILEPOS).
2179:	ED91  72      		LD	(HL),D
2180:	ED92  2B      		DEC	HL
2181:	ED93  73      		LD	(HL),E
2182:	ED94  C9      		RET	
2183:			;
2184:			;   Compute (HL)=(DE)-(HL)
2185:			;
2186:	ED95  7B      	SUBHL:	LD	A,E		;compute difference.
2187:	ED96  95      		SUB	L
2188:	ED97  6F      		LD	L,A		;store low byte.
2189:	ED98  7A      		LD	A,D
2190:	ED99  9C      		SBC	A,H
2191:	ED9A  67      		LD	H,A		;and then high byte.
2192:	ED9B  C9      		RET	
2193:			;
2194:			;   Set the directory checksum byte.
2195:			;
2196:	ED9C  0EFF    	SETDIR:	LD	C,0FFH
2197:			;
2198:			;   Routine to set or compare the directory checksum byte. If
2199:			; (C)=0ffh, then this will set the checksum byte. Else the byte
2200:			; will be checked. If the check fails (the disk has been changed),
2201:			; then this disk will be write protected.
2202:			;
2203:	ED9E  2AECF5  	CHECKDIR: LD	HL,(CKSUMTBL)
2204:	EDA1  EB      		EX	DE,HL
2205:	EDA2  2ACCF5  		LD	HL,(ALLOC1)
2206:	EDA5  CD95ED  		CALL	SUBHL
2207:	EDA8  D0      		RET	NC		;ok if (CKSUMTBL) > (ALLOC1), so return.
2208:	EDA9  C5      		PUSH	BC
2209:	EDAA  CDF7EC  		CALL	CHECKSUM	;else compute checksum.
2210:	EDAD  2ABDF5  		LD	HL,(CHKVECT)	;get address of checksum table.
2211:	EDB0  EB      		EX	DE,HL
2212:	EDB1  2AECF5  		LD	HL,(CKSUMTBL)
2213:	EDB4  19      		ADD	HL,DE		;set (HL) to point to byte for this drive.
2214:	EDB5  C1      		POP	BC
2215:	EDB6  0C      		INC	C		;set or check ?
2216:	EDB7  CAC4ED  		JP	Z,CHKDIR1
2217:	EDBA  BE      		CP	(HL)		;check them.
2218:	EDBB  C8      		RET	Z		;return if they are the same.
2219:	EDBC  CD7FED  		CALL	MOREFLS		;not the same, do we care?
2220:	EDBF  D0      		RET	NC
2221:	EDC0  CD2CED  		CALL	WRTPRTD		;yes, mark this as write protected.
2222:	EDC3  C9      		RET	
2223:	EDC4  77      	CHKDIR1:LD	(HL),A		;just set the byte.
2224:	EDC5  C9      		RET	
2225:			;
2226:			;   Do a write to the directory of the current disk.
2227:			;
2228:	EDC6  CD9CED  	DIRWRITE: CALL	SETDIR		;set checksum byte.
2229:	EDC9  CDE0ED  		CALL	DIRDMA		;set directory dma address.
2230:	EDCC  0E01    		LD	C,1		;tell the bios to actually write.
2231:	EDCE  CDB8EB  		CALL	DOWRITE		;then do the write.
2232:	EDD1  C3DAED  		JP	DEFDMA
2233:			;
2234:			;   Read from the directory.
2235:			;
2236:	EDD4  CDE0ED  	DIRREAD:CALL	DIRDMA		;set the directory dma address.
2237:	EDD7  CDB2EB  		CALL	DOREAD		;and read it.
2238:			;
2239:			;   Routine to set the dma address to the users choice.
2240:			;
2241:	EDDA  21B1F5  	DEFDMA:	LD	HL,USERDMA	;reset the default dma address and return.
2242:	EDDD  C3E3ED  		JP	DIRDMA1
2243:			;
2244:			;   Routine to set the dma address for directory work.
2245:			;
2246:	EDE0  21B9F5  	DIRDMA:	LD	HL,DIRBUF
2247:			;
2248:			;   Set the dma address. On entry, (HL) points to
2249:			; word containing the desired dma address.
2250:			;
2251:	EDE3  4E      	DIRDMA1:LD	C,(HL)
2252:	EDE4  23      		INC	HL
2253:	EDE5  46      		LD	B,(HL)		;setup (BC) and go to the bios to set it.
2254:	EDE6  C324F6  		JP	SETDMA
2255:			;
2256:			;   Move the directory buffer into user's dma space.
2257:			;
2258:	EDE9  2AB9F5  	MOVEDIR:LD	HL,(DIRBUF)	;buffer is located here, and
2259:	EDEC  EB      		EX	DE,HL
2260:	EDED  2AB1F5  		LD	HL,(USERDMA)	; put it here.
2261:	EDF0  0E80    		LD	C,128		;this is its length.
2262:	EDF2  C34FEB  		JP	DE2HL		;move it now and return.
2263:			;
2264:			;   Check (FILEPOS) and set the zero flag if it equals 0ffffh.
2265:			;
2266:	EDF5  21EAF5  	CKFILPOS: LD	HL,FILEPOS
2267:	EDF8  7E      		LD	A,(HL)
2268:	EDF9  23      		INC	HL
2269:	EDFA  BE      		CP	(HL)		;are both bytes the same?
2270:	EDFB  C0      		RET	NZ
2271:	EDFC  3C      		INC	A		;yes, but are they each 0ffh?
2272:	EDFD  C9      		RET	
2273:			;
2274:			;   Set location (FILEPOS) to 0ffffh.
2275:			;
2276:	EDFE  21FFFF  	STFILPOS: LD	HL,0FFFFH
2277:	EE01  22EAF5  		LD	(FILEPOS),HL
2278:	EE04  C9      		RET	
2279:			;
2280:			;   Move on to the next file position within the current
2281:			; directory buffer. If no more exist, set pointer to 0ffffh
2282:			; and the calling routine will check for this. Enter with (C)
2283:			; equal to 0ffh to cause the checksum byte to be set, else we
2284:			; will check this disk and set write protect if checksums are
2285:			; not the same (applies only if another directory sector must
2286:			; be read).
2287:			;
2288:	EE05  2AC8F5  	NXENTRY:LD	HL,(DIRSIZE)	;get directory entry size limit.
2289:	EE08  EB      		EX	DE,HL
2290:	EE09  2AEAF5  		LD	HL,(FILEPOS)	;get current count.
2291:	EE0C  23      		INC	HL		;go on to the next one.
2292:	EE0D  22EAF5  		LD	(FILEPOS),HL
2293:	EE10  CD95ED  		CALL	SUBHL		;(HL)=(DIRSIZE)-(FILEPOS)
2294:	EE13  D219EE  		JP	NC,NXENT1	;is there more room left?
2295:	EE16  C3FEED  		JP	STFILPOS	;no. Set this flag and return.
2296:	EE19  3AEAF5  	NXENT1:	LD	A,(FILEPOS)	;get file position within directory.
2297:	EE1C  E603    		AND	03H		;only look within this sector (only 4 entries fit).
2298:	EE1E  0605    		LD	B,5		;convert to relative position (32 bytes each).
2299:	EE20  87      	NXENT2:	ADD	A,A		;note that this is not efficient code.
2300:	EE21  05      		DEC	B		;5 'ADD A's would be better.
2301:	EE22  C220EE  		JP	NZ,NXENT2
2302:	EE25  32E9F5  		LD	(FCBPOS),A	;save it as position of fcb.
2303:	EE28  B7      		OR	A
2304:	EE29  C0      		RET	NZ		;return if we are within buffer.
2305:	EE2A  C5      		PUSH	BC
2306:	EE2B  CDC3EB  		CALL	TRKSEC		;we need the next directory sector.
2307:	EE2E  CDD4ED  		CALL	DIRREAD
2308:	EE31  C1      		POP	BC
2309:	EE32  C39EED  		JP	CHECKDIR
2310:			;
2311:			;   Routine to to get a bit from the disk space allocation
2312:			; map. It is returned in (A), bit position 0. On entry to here,
2313:			; set (BC) to the block number on the disk to check.
2314:			; On return, (D) will contain the original bit position for
2315:			; this block number and (HL) will point to the address for it.
2316:			;
2317:	EE35  79      	CKBITMAP: LD	A,C		;determine bit number of interest.
2318:	EE36  E607    		AND	07H		;compute (D)=(E)=(C and 7)+1.
2319:	EE38  3C      		INC	A
2320:	EE39  5F      		LD	E,A		;save particular bit number.
2321:	EE3A  57      		LD	D,A
2322:			;
2323:			;   compute (BC)=(BC)/8.
2324:			;
2325:	EE3B  79      		LD	A,C
2326:	EE3C  0F      		RRCA			;now shift right 3 bits.
2327:	EE3D  0F      		RRCA	
2328:	EE3E  0F      		RRCA	
2329:	EE3F  E61F    		AND	1FH		;and clear bits 7,6,5.
2330:	EE41  4F      		LD	C,A
2331:	EE42  78      		LD	A,B
2332:	EE43  87      		ADD	A,A		;now shift (B) into bits 7,6,5.
2333:	EE44  87      		ADD	A,A
2334:	EE45  87      		ADD	A,A
2335:	EE46  87      		ADD	A,A
2336:	EE47  87      		ADD	A,A
2337:	EE48  B1      		OR	C		;and add in (C).
2338:	EE49  4F      		LD	C,A		;ok, (C) ha been completed.
2339:	EE4A  78      		LD	A,B		;is there a better way of doing this?
2340:	EE4B  0F      		RRCA	
2341:	EE4C  0F      		RRCA	
2342:	EE4D  0F      		RRCA	
2343:	EE4E  E61F    		AND	1FH
2344:	EE50  47      		LD	B,A		;and now (B) is completed.
2345:			;
2346:			;   use this as an offset into the disk space allocation
2347:			; table.
2348:			;
2349:	EE51  2ABFF5  		LD	HL,(ALOCVECT)
2350:	EE54  09      		ADD	HL,BC
2351:	EE55  7E      		LD	A,(HL)		;now get correct byte.
2352:	EE56  07      	CKBMAP1:RLCA			;get correct bit into position 0.
2353:	EE57  1D      		DEC	E
2354:	EE58  C256EE  		JP	NZ,CKBMAP1
2355:	EE5B  C9      		RET	
2356:			;
2357:			;   Set or clear the bit map such that block number (BC) will be marked
2358:			; as used. On entry, if (E)=0 then this bit will be cleared, if it equals
2359:			; 1 then it will be set (don't use anyother values).
2360:			;
2361:	EE5C  D5      	STBITMAP: PUSH	DE
2362:	EE5D  CD35EE  		CALL	CKBITMAP	;get the byte of interest.
2363:	EE60  E6FE    		AND	0FEH		;clear the affected bit.
2364:	EE62  C1      		POP	BC
2365:	EE63  B1      		OR	C		;and now set it acording to (C).
2366:			;
2367:			;  entry to restore the original bit position and then store
2368:			; in table. (A) contains the value, (D) contains the bit
2369:			; position (1-8), and (HL) points to the address within the
2370:			; space allocation table for this byte.
2371:			;
2372:	EE64  0F      	STBMAP1:RRCA			;restore original bit position.
2373:	EE65  15      		DEC	D
2374:	EE66  C264EE  		JP	NZ,STBMAP1
2375:	EE69  77      		LD	(HL),A		;and stor byte in table.
2376:	EE6A  C9      		RET	
2377:			;
2378:			;   Set/clear space used bits in allocation map for this file.
2379:			; On entry, (C)=1 to set the map and (C)=0 to clear it.
2380:			;
2381:	EE6B  CD5EED  	SETFILE:CALL	FCB2HL		;get address of fcb
2382:	EE6E  111000  		LD	DE,16
2383:	EE71  19      		ADD	HL,DE		;get to block number bytes.
2384:	EE72  C5      		PUSH	BC
2385:	EE73  0E11    		LD	C,17		;check all 17 bytes (max) of table.
2386:	EE75  D1      	SETFL1:	POP	DE
2387:	EE76  0D      		DEC	C		;done all bytes yet?
2388:	EE77  C8      		RET	Z
2389:	EE78  D5      		PUSH	DE
2390:	EE79  3ADDF5  		LD	A,(BIGDISK)	;check disk size for 16 bit block numbers.
2391:	EE7C  B7      		OR	A
2392:	EE7D  CA88EE  		JP	Z,SETFL2
2393:	EE80  C5      		PUSH	BC		;only 8 bit numbers. set (BC) to this one.
2394:	EE81  E5      		PUSH	HL
2395:	EE82  4E      		LD	C,(HL)		;get low byte from table, always
2396:	EE83  0600    		LD	B,0		;set high byte to zero.
2397:	EE85  C38EEE  		JP	SETFL3
2398:	EE88  0D      	SETFL2:	DEC	C		;for 16 bit block numbers, adjust counter.
2399:	EE89  C5      		PUSH	BC
2400:	EE8A  4E      		LD	C,(HL)		;now get both the low and high bytes.
2401:	EE8B  23      		INC	HL
2402:	EE8C  46      		LD	B,(HL)
2403:	EE8D  E5      		PUSH	HL
2404:	EE8E  79      	SETFL3:	LD	A,C		;block used?
2405:	EE8F  B0      		OR	B
2406:	EE90  CA9DEE  		JP	Z,SETFL4
2407:	EE93  2AC6F5  		LD	HL,(DSKSIZE)	;is this block number within the
2408:	EE96  7D      		LD	A,L		;space on the disk?
2409:	EE97  91      		SUB	C
2410:	EE98  7C      		LD	A,H
2411:	EE99  98      		SBC	A,B
2412:	EE9A  D45CEE  		CALL	NC,STBITMAP	;yes, set the proper bit.
2413:	EE9D  E1      	SETFL4:	POP	HL		;point to next block number in fcb.
2414:	EE9E  23      		INC	HL
2415:	EE9F  C1      		POP	BC
2416:	EEA0  C375EE  		JP	SETFL1
2417:			;
2418:			;   Construct the space used allocation bit map for the active
2419:			; drive. If a file name starts with '$' and it is under the
2420:			; current user number, then (STATUS) is set to minus 1. Otherwise
2421:			; it is not set at all.
2422:			;
2423:	EEA3  2AC6F5  	BITMAP:	LD	HL,(DSKSIZE)	;compute size of allocation table.
2424:	EEA6  0E03    		LD	C,3
2425:	EEA8  CDEAEC  		CALL	SHIFTR		;(HL)=(HL)/8.
2426:	EEAB  23      		INC	HL		;at lease 1 byte.
2427:	EEAC  44      		LD	B,H
2428:	EEAD  4D      		LD	C,L		;set (BC) to the allocation table length.
2429:			;
2430:			;   Initialize the bitmap for this drive. Right now, the first
2431:			; two bytes are specified by the disk parameter block. However
2432:			; a patch could be entered here if it were necessary to setup
2433:			; this table in a special mannor. For example, the bios could
2434:			; determine locations of 'bad blocks' and set them as already
2435:			; 'used' in the map.
2436:			;
2437:	EEAE  2ABFF5  		LD	HL,(ALOCVECT)	;now zero out the table now.
2438:	EEB1  3600    	BITMAP1:LD	(HL),0
2439:	EEB3  23      		INC	HL
2440:	EEB4  0B      		DEC	BC
2441:	EEB5  78      		LD	A,B
2442:	EEB6  B1      		OR	C
2443:	EEB7  C2B1EE  		JP	NZ,BITMAP1
2444:	EEBA  2ACAF5  		LD	HL,(ALLOC0)	;get initial space used by directory.
2445:	EEBD  EB      		EX	DE,HL
2446:	EEBE  2ABFF5  		LD	HL,(ALOCVECT)	;and put this into map.
2447:	EEC1  73      		LD	(HL),E
2448:	EEC2  23      		INC	HL
2449:	EEC3  72      		LD	(HL),D
2450:			;
2451:			;   End of initialization portion.
2452:			;
2453:	EEC4  CDA1EB  		CALL	HOMEDRV		;now home the drive.
2454:	EEC7  2AB3F5  		LD	HL,(SCRATCH1)
2455:	EECA  3603    		LD	(HL),3		;force next directory request to read
2456:	EECC  23      		INC	HL		;in a sector.
2457:	EECD  3600    		LD	(HL),0
2458:	EECF  CDFEED  		CALL	STFILPOS	;clear initial file position also.
2459:	EED2  0EFF    	BITMAP2:LD	C,0FFH		;read next file name in directory
2460:	EED4  CD05EE  		CALL	NXENTRY		;and set checksum byte.
2461:	EED7  CDF5ED  		CALL	CKFILPOS	;is there another file?
2462:	EEDA  C8      		RET	Z
2463:	EEDB  CD5EED  		CALL	FCB2HL		;yes, get its address.
2464:	EEDE  3EE5    		LD	A,0E5H
2465:	EEE0  BE      		CP	(HL)		;empty file entry?
2466:	EEE1  CAD2EE  		JP	Z,BITMAP2
2467:	EEE4  3A41EB  		LD	A,(USERNO)	;no, correct user number?
2468:	EEE7  BE      		CP	(HL)
2469:	EEE8  C2F6EE  		JP	NZ,BITMAP3
2470:	EEEB  23      		INC	HL
2471:	EEEC  7E      		LD	A,(HL)		;yes, does name start with a '$'?
2472:	EEED  D624    		SUB	'$'
2473:	EEEF  C2F6EE  		JP	NZ,BITMAP3
2474:	EEF2  3D      		DEC	A		;yes, set atatus to minus one.
2475:	EEF3  3245EB  		LD	(STATUS),A
2476:	EEF6  0E01    	BITMAP3:LD	C,1		;now set this file's space as used in bit map.
2477:	EEF8  CD6BEE  		CALL	SETFILE
2478:	EEFB  CD8CED  		CALL	CHKNMBR		;keep (SCRATCH1) in bounds.
2479:	EEFE  C3D2EE  		JP	BITMAP2
2480:			;
2481:			;   Set the status (STATUS) and return.
2482:			;
2483:	EF01  3AD4F5  	STSTATUS: LD	A,(FNDSTAT)
2484:	EF04  C301EB  		JP	SETSTAT
2485:			;
2486:			;   Check extents in (A) and (C). Set the zero flag if they
2487:			; are the same. The number of 16k chunks of disk space that
2488:			; the directory extent covers is expressad is (EXTMASK+1).
2489:			; No registers are modified.
2490:			;
2491:	EF07  C5      	SAMEXT:	PUSH	BC
2492:	EF08  F5      		PUSH	AF
2493:	EF09  3AC5F5  		LD	A,(EXTMASK)	;get extent mask and use it to
2494:	EF0C  2F      		CPL			;to compare both extent numbers.
2495:	EF0D  47      		LD	B,A		;save resulting mask here.
2496:	EF0E  79      		LD	A,C		;mask first extent and save in (C).
2497:	EF0F  A0      		AND	B
2498:	EF10  4F      		LD	C,A
2499:	EF11  F1      		POP	AF		;now mask second extent and compare
2500:	EF12  A0      		AND	B		;with the first one.
2501:	EF13  91      		SUB	C
2502:	EF14  E61F    		AND	1FH		;(* only check buts 0-4 *)
2503:	EF16  C1      		POP	BC		;the zero flag is set if they are the same.
2504:	EF17  C9      		RET			;restore (BC) and return.
2505:			;
2506:			;   Search for the first occurence of a file name. On entry,
2507:			; register (C) should contain the number of bytes of the fcb
2508:			; that must match.
2509:			;
2510:	EF18  3EFF    	FINDFST:LD	A,0FFH
2511:	EF1A  32D4F5  		LD	(FNDSTAT),A
2512:	EF1D  21D8F5  		LD	HL,COUNTER	;save character count.
2513:	EF20  71      		LD	(HL),C
2514:	EF21  2A43EB  		LD	HL,(PARAMS)	;get filename to match.
2515:	EF24  22D9F5  		LD	(SAVEFCB),HL	;and save.
2516:	EF27  CDFEED  		CALL	STFILPOS	;clear initial file position (set to 0ffffh).
2517:	EF2A  CDA1EB  		CALL	HOMEDRV		;home the drive.
2518:			;
2519:			;   Entry to locate the next occurence of a filename within the
2520:			; directory. The disk is not expected to have been changed. If
2521:			; it was, then it will be write protected.
2522:			;
2523:	EF2D  0E00    	FINDNXT:LD	C,0		;write protect the disk if changed.
2524:	EF2F  CD05EE  		CALL	NXENTRY		;get next filename entry in directory.
2525:	EF32  CDF5ED  		CALL	CKFILPOS	;is file position = 0ffffh?
2526:	EF35  CA94EF  		JP	Z,FNDNXT6	;yes, exit now then.
2527:	EF38  2AD9F5  		LD	HL,(SAVEFCB)	;set (DE) pointing to filename to match.
2528:	EF3B  EB      		EX	DE,HL
2529:	EF3C  1A      		LD	A,(DE)
2530:	EF3D  FEE5    		CP	0E5H		;empty directory entry?
2531:	EF3F  CA4AEF  		JP	Z,FNDNXT1	;(* are we trying to reserect erased entries? *)
2532:	EF42  D5      		PUSH	DE
2533:	EF43  CD7FED  		CALL	MOREFLS		;more files in directory?
2534:	EF46  D1      		POP	DE
2535:	EF47  D294EF  		JP	NC,FNDNXT6	;no more. Exit now.
2536:	EF4A  CD5EED  	FNDNXT1:CALL	FCB2HL		;get address of this fcb in directory.
2537:	EF4D  3AD8F5  		LD	A,(COUNTER)	;get number of bytes (characters) to check.
2538:	EF50  4F      		LD	C,A
2539:	EF51  0600    		LD	B,0		;initialize byte position counter.
2540:	EF53  79      	FNDNXT2:LD	A,C		;are we done with the compare?
2541:	EF54  B7      		OR	A
2542:	EF55  CA83EF  		JP	Z,FNDNXT5
2543:	EF58  1A      		LD	A,(DE)		;no, check next byte.
2544:	EF59  FE3F    		CP	'?'		;don't care about this character?
2545:	EF5B  CA7CEF  		JP	Z,FNDNXT4
2546:	EF5E  78      		LD	A,B		;get bytes position in fcb.
2547:	EF5F  FE0D    		CP	13		;don't care about the thirteenth byte either.
2548:	EF61  CA7CEF  		JP	Z,FNDNXT4
2549:	EF64  FE0C    		CP	12		;extent byte?
2550:	EF66  1A      		LD	A,(DE)
2551:	EF67  CA73EF  		JP	Z,FNDNXT3
2552:	EF6A  96      		SUB	(HL)		;otherwise compare characters.
2553:	EF6B  E67F    		AND	7FH
2554:	EF6D  C22DEF  		JP	NZ,FINDNXT	;not the same, check next entry.
2555:	EF70  C37CEF  		JP	FNDNXT4		;so far so good, keep checking.
2556:	EF73  C5      	FNDNXT3:PUSH	BC		;check the extent byte here.
2557:	EF74  4E      		LD	C,(HL)
2558:	EF75  CD07EF  		CALL	SAMEXT
2559:	EF78  C1      		POP	BC
2560:	EF79  C22DEF  		JP	NZ,FINDNXT	;not the same, look some more.
2561:			;
2562:			;   So far the names compare. Bump pointers to the next byte
2563:			; and continue until all (C) characters have been checked.
2564:			;
2565:	EF7C  13      	FNDNXT4:INC	DE		;bump pointers.
2566:	EF7D  23      		INC	HL
2567:	EF7E  04      		INC	B
2568:	EF7F  0D      		DEC	C		;adjust character counter.
2569:	EF80  C353EF  		JP	FNDNXT2
2570:	EF83  3AEAF5  	FNDNXT5:LD	A,(FILEPOS)	;return the position of this entry.
2571:	EF86  E603    		AND	03H
2572:	EF88  3245EB  		LD	(STATUS),A
2573:	EF8B  21D4F5  		LD	HL,FNDSTAT
2574:	EF8E  7E      		LD	A,(HL)
2575:	EF8F  17      		RLA	
2576:	EF90  D0      		RET	NC
2577:	EF91  AF      		XOR	A
2578:	EF92  77      		LD	(HL),A
2579:	EF93  C9      		RET	
2580:			;
2581:			;   Filename was not found. Set appropriate status.
2582:			;
2583:	EF94  CDFEED  	FNDNXT6:CALL	STFILPOS	;set (FILEPOS) to 0ffffh.
2584:	EF97  3EFF    		LD	A,0FFH		;say not located.
2585:	EF99  C301EB  		JP	SETSTAT
2586:			;
2587:			;   Erase files from the directory. Only the first byte of the
2588:			; fcb will be affected. It is set to (E5).
2589:			;
2590:	EF9C  CD54ED  	ERAFILE:CALL	CHKWPRT		;is disk write protected?
2591:	EF9F  0E0C    		LD	C,12		;only compare file names.
2592:	EFA1  CD18EF  		CALL	FINDFST		;get first file name.
2593:	EFA4  CDF5ED  	ERAFIL1:CALL	CKFILPOS	;any found?
2594:	EFA7  C8      		RET	Z		;nope, we must be done.
2595:	EFA8  CD44ED  		CALL	CHKROFL		;is file read only?
2596:	EFAB  CD5EED  		CALL	FCB2HL		;nope, get address of fcb and
2597:	EFAE  36E5    		LD	(HL),0E5H	;set first byte to 'empty'.
2598:	EFB0  0E00    		LD	C,0		;clear the space from the bit map.
2599:	EFB2  CD6BEE  		CALL	SETFILE
2600:	EFB5  CDC6ED  		CALL	DIRWRITE	;now write the directory sector back out.
2601:	EFB8  CD2DEF  		CALL	FINDNXT		;find the next file name.
2602:	EFBB  C3A4EF  		JP	ERAFIL1		;and repeat process.
2603:			;
2604:			;   Look through the space allocation map (bit map) for the
2605:			; next available block. Start searching at block number (BC-1).
2606:			; The search procedure is to look for an empty block that is
2607:			; before the starting block. If not empty, look at a later
2608:			; block number. In this way, we return the closest empty block
2609:			; on either side of the 'target' block number. This will speed
2610:			; access on random devices. For serial devices, this should be
2611:			; changed to look in the forward direction first and then start
2612:			; at the front and search some more.
2613:			;
2614:			;   On return, (DE)= block number that is empty and (HL) =0
2615:			; if no empry block was found.
2616:			;
2617:	EFBE  50      	FNDSPACE: LD	D,B		;set (DE) as the block that is checked.
2618:	EFBF  59      		LD	E,C
2619:			;
2620:			;   Look before target block. Registers (BC) are used as the lower
2621:			; pointer and (DE) as the upper pointer.
2622:			;
2623:	EFC0  79      	FNDSPA1:LD	A,C		;is block 0 specified?
2624:	EFC1  B0      		OR	B
2625:	EFC2  CAD1EF  		JP	Z,FNDSPA2
2626:	EFC5  0B      		DEC	BC		;nope, check previous block.
2627:	EFC6  D5      		PUSH	DE
2628:	EFC7  C5      		PUSH	BC
2629:	EFC8  CD35EE  		CALL	CKBITMAP
2630:	EFCB  1F      		RRA			;is this block empty?
2631:	EFCC  D2ECEF  		JP	NC,FNDSPA3	;yes. use this.
2632:			;
2633:			;   Note that the above logic gets the first block that it finds
2634:			; that is empty. Thus a file could be written 'backward' making
2635:			; it very slow to access. This could be changed to look for the
2636:			; first empty block and then continue until the start of this
2637:			; empty space is located and then used that starting block.
2638:			; This should help speed up access to some files especially on
2639:			; a well used disk with lots of fairly small 'holes'.
2640:			;
2641:	EFCF  C1      		POP	BC		;nope, check some more.
2642:	EFD0  D1      		POP	DE
2643:			;
2644:			;   Now look after target block.
2645:			;
2646:	EFD1  2AC6F5  	FNDSPA2:LD	HL,(DSKSIZE)	;is block (DE) within disk limits?
2647:	EFD4  7B      		LD	A,E
2648:	EFD5  95      		SUB	L
2649:	EFD6  7A      		LD	A,D
2650:	EFD7  9C      		SBC	A,H
2651:	EFD8  D2F4EF  		JP	NC,FNDSPA4
2652:	EFDB  13      		INC	DE		;yes, move on to next one.
2653:	EFDC  C5      		PUSH	BC
2654:	EFDD  D5      		PUSH	DE
2655:	EFDE  42      		LD	B,D
2656:	EFDF  4B      		LD	C,E
2657:	EFE0  CD35EE  		CALL	CKBITMAP	;check it.
2658:	EFE3  1F      		RRA			;empty?
2659:	EFE4  D2ECEF  		JP	NC,FNDSPA3
2660:	EFE7  D1      		POP	DE		;nope, continue searching.
2661:	EFE8  C1      		POP	BC
2662:	EFE9  C3C0EF  		JP	FNDSPA1
2663:			;
2664:			;   Empty block found. Set it as used and return with (HL)
2665:			; pointing to it (true?).
2666:			;
2667:	EFEC  17      	FNDSPA3:RLA			;reset byte.
2668:	EFED  3C      		INC	A		;and set bit 0.
2669:	EFEE  CD64EE  		CALL	STBMAP1		;update bit map.
2670:	EFF1  E1      		POP	HL		;set return registers.
2671:	EFF2  D1      		POP	DE
2672:	EFF3  C9      		RET	
2673:			;
2674:			;   Free block was not found. If (BC) is not zero, then we have
2675:			; not checked all of the disk space.
2676:			;
2677:	EFF4  79      	FNDSPA4:LD	A,C
2678:	EFF5  B0      		OR	B
2679:	EFF6  C2C0EF  		JP	NZ,FNDSPA1
2680:	EFF9  210000  		LD	HL,0		;set 'not found' status.
2681:	EFFC  C9      		RET	
2682:			;
2683:			;   Move a complete fcb entry into the directory and write it.
2684:			;
2685:	EFFD  0E00    	FCBSET:	LD	C,0
2686:	EFFF  1E20    		LD	E,32		;length of each entry.
2687:			;
2688:			;   Move (E) bytes from the fcb pointed to by (PARAMS) into
2689:			; fcb in directory starting at relative byte (C). This updated
2690:			; directory buffer is then written to the disk.
2691:			;
2692:	F001  D5      	UPDATE:	PUSH	DE
2693:	F002  0600    		LD	B,0		;set (BC) to relative byte position.
2694:	F004  2A43EB  		LD	HL,(PARAMS)	;get address of fcb.
2695:	F007  09      		ADD	HL,BC		;compute starting byte.
2696:	F008  EB      		EX	DE,HL
2697:	F009  CD5EED  		CALL	FCB2HL		;get address of fcb to update in directory.
2698:	F00C  C1      		POP	BC		;set (C) to number of bytes to change.
2699:	F00D  CD4FEB  		CALL	DE2HL
2700:	F010  CDC3EB  	UPDATE1:CALL	TRKSEC		;determine the track and sector affected.
2701:	F013  C3C6ED  		JP	DIRWRITE	;then write this sector out.
2702:			;
2703:			;   Routine to change the name of all files on the disk with a
2704:			; specified name. The fcb contains the current name as the
2705:			; first 12 characters and the new name 16 bytes into the fcb.
2706:			;
2707:	F016  CD54ED  	CHGNAMES: CALL	CHKWPRT		;check for a write protected disk.
2708:	F019  0E0C    		LD	C,12		;match first 12 bytes of fcb only.
2709:	F01B  CD18EF  		CALL	FINDFST		;get first name.
2710:	F01E  2A43EB  		LD	HL,(PARAMS)	;get address of fcb.
2711:	F021  7E      		LD	A,(HL)		;get user number.
2712:	F022  111000  		LD	DE,16		;move over to desired name.
2713:	F025  19      		ADD	HL,DE
2714:	F026  77      		LD	(HL),A		;keep same user number.
2715:	F027  CDF5ED  	CHGNAM1:CALL	CKFILPOS	;any matching file found?
2716:	F02A  C8      		RET	Z		;no, we must be done.
2717:	F02B  CD44ED  		CALL	CHKROFL		;check for read only file.
2718:	F02E  0E10    		LD	C,16		;start 16 bytes into fcb.
2719:	F030  1E0C    		LD	E,12		;and update the first 12 bytes of directory.
2720:	F032  CD01F0  		CALL	UPDATE
2721:	F035  CD2DEF  		CALL	FINDNXT		;get te next file name.
2722:	F038  C327F0  		JP	CHGNAM1		;and continue.
2723:			;
2724:			;   Update a files attributes. The procedure is to search for
2725:			; every file with the same name as shown in fcb (ignoring bit 7)
2726:			; and then to update it (which includes bit 7). No other changes
2727:			; are made.
2728:			;
2729:	F03B  0E0C    	SAVEATTR: LD	C,12		;match first 12 bytes.
2730:	F03D  CD18EF  		CALL	FINDFST		;look for first filename.
2731:	F040  CDF5ED  	SAVATR1:CALL	CKFILPOS	;was one found?
2732:	F043  C8      		RET	Z		;nope, we must be done.
2733:	F044  0E00    		LD	C,0		;yes, update the first 12 bytes now.
2734:	F046  1E0C    		LD	E,12
2735:	F048  CD01F0  		CALL	UPDATE		;update filename and write directory.
2736:	F04B  CD2DEF  		CALL	FINDNXT		;and get the next file.
2737:	F04E  C340F0  		JP	SAVATR1		;then continue until done.
2738:			;
2739:			;  Open a file (name specified in fcb).
2740:			;
2741:	F051  0E0F    	OPENIT:	LD	C,15		;compare the first 15 bytes.
2742:	F053  CD18EF  		CALL	FINDFST		;get the first one in directory.
2743:	F056  CDF5ED  		CALL	CKFILPOS	;any at all?
2744:	F059  C8      		RET	Z
2745:	F05A  CDA6EC  	OPENIT1:CALL	SETEXT		;point to extent byte within users fcb.
2746:	F05D  7E      		LD	A,(HL)		;and get it.
2747:	F05E  F5      		PUSH	AF		;save it and address.
2748:	F05F  E5      		PUSH	HL
2749:	F060  CD5EED  		CALL	FCB2HL		;point to fcb in directory.
2750:	F063  EB      		EX	DE,HL
2751:	F064  2A43EB  		LD	HL,(PARAMS)	;this is the users copy.
2752:	F067  0E20    		LD	C,32		;move it into users space.
2753:	F069  D5      		PUSH	DE
2754:	F06A  CD4FEB  		CALL	DE2HL
2755:	F06D  CD78ED  		CALL	SETS2B7		;set bit 7 in 's2' byte (unmodified).
2756:	F070  D1      		POP	DE		;now get the extent byte from this fcb.
2757:	F071  210C00  		LD	HL,12
2758:	F074  19      		ADD	HL,DE
2759:	F075  4E      		LD	C,(HL)		;into (C).
2760:	F076  210F00  		LD	HL,15		;now get the record count byte into (B).
2761:	F079  19      		ADD	HL,DE
2762:	F07A  46      		LD	B,(HL)
2763:	F07B  E1      		POP	HL		;keep the same extent as the user had originally.
2764:	F07C  F1      		POP	AF
2765:	F07D  77      		LD	(HL),A
2766:	F07E  79      		LD	A,C		;is it the same as in the directory fcb?
2767:	F07F  BE      		CP	(HL)
2768:	F080  78      		LD	A,B		;if yes, then use the same record count.
2769:	F081  CA8BF0  		JP	Z,OPENIT2
2770:	F084  3E00    		LD	A,0		;if the user specified an extent greater than
2771:	F086  DA8BF0  		JP	C,OPENIT2	;the one in the directory, then set record count to 0.
2772:	F089  3E80    		LD	A,128		;otherwise set to maximum.
2773:	F08B  2A43EB  	OPENIT2:LD	HL,(PARAMS)	;set record count in users fcb to (A).
2774:	F08E  110F00  		LD	DE,15
2775:	F091  19      		ADD	HL,DE		;compute relative position.
2776:	F092  77      		LD	(HL),A		;and set the record count.
2777:	F093  C9      		RET	
2778:			;
2779:			;   Move two bytes from (DE) to (HL) if (and only if) (HL)
2780:			; point to a zero value (16 bit).
2781:			;   Return with zero flag set it (DE) was moved. Registers (DE)
2782:			; and (HL) are not changed. However (A) is.
2783:			;
2784:	F094  7E      	MOVEWORD: LD	A,(HL)		;check for a zero word.
2785:	F095  23      		INC	HL
2786:	F096  B6      		OR	(HL)		;both bytes zero?
2787:	F097  2B      		DEC	HL
2788:	F098  C0      		RET	NZ		;nope, just return.
2789:	F099  1A      		LD	A,(DE)		;yes, move two bytes from (DE) into
2790:	F09A  77      		LD	(HL),A		;this zero space.
2791:	F09B  13      		INC	DE
2792:	F09C  23      		INC	HL
2793:	F09D  1A      		LD	A,(DE)
2794:	F09E  77      		LD	(HL),A
2795:	F09F  1B      		DEC	DE		;don't disturb these registers.
2796:	F0A0  2B      		DEC	HL
2797:	F0A1  C9      		RET	
2798:			;
2799:			;   Get here to close a file specified by (fcb).
2800:			;
2801:	F0A2  AF      	CLOSEIT:XOR	A		;clear status and file position bytes.
2802:	F0A3  3245EB  		LD	(STATUS),A
2803:	F0A6  32EAF5  		LD	(FILEPOS),A
2804:	F0A9  32EBF5  		LD	(FILEPOS+1),A
2805:	F0AC  CD1EED  		CALL	GETWPRT		;get write protect bit for this drive.
2806:	F0AF  C0      		RET	NZ		;just return if it is set.
2807:	F0B0  CD69ED  		CALL	GETS2		;else get the 's2' byte.
2808:	F0B3  E680    		AND	80H		;and look at bit 7 (file unmodified?).
2809:	F0B5  C0      		RET	NZ		;just return if set.
2810:	F0B6  0E0F    		LD	C,15		;else look up this file in directory.
2811:	F0B8  CD18EF  		CALL	FINDFST
2812:	F0BB  CDF5ED  		CALL	CKFILPOS	;was it found?
2813:	F0BE  C8      		RET	Z		;just return if not.
2814:	F0BF  011000  		LD	BC,16		;set (HL) pointing to records used section.
2815:	F0C2  CD5EED  		CALL	FCB2HL
2816:	F0C5  09      		ADD	HL,BC
2817:	F0C6  EB      		EX	DE,HL
2818:	F0C7  2A43EB  		LD	HL,(PARAMS)	;do the same for users specified fcb.
2819:	F0CA  09      		ADD	HL,BC
2820:	F0CB  0E10    		LD	C,16		;this many bytes are present in this extent.
2821:	F0CD  3ADDF5  	CLOSEIT1: LD	A,(BIGDISK)	;8 or 16 bit record numbers?
2822:	F0D0  B7      		OR	A
2823:	F0D1  CAE8F0  		JP	Z,CLOSEIT4
2824:	F0D4  7E      		LD	A,(HL)		;just 8 bit. Get one from users fcb.
2825:	F0D5  B7      		OR	A
2826:	F0D6  1A      		LD	A,(DE)		;now get one from directory fcb.
2827:	F0D7  C2DBF0  		JP	NZ,CLOSEIT2
2828:	F0DA  77      		LD	(HL),A		;users byte was zero. Update from directory.
2829:	F0DB  B7      	CLOSEIT2: OR	A
2830:	F0DC  C2E1F0  		JP	NZ,CLOSEIT3
2831:	F0DF  7E      		LD	A,(HL)		;directories byte was zero, update from users fcb.
2832:	F0E0  12      		LD	(DE),A
2833:	F0E1  BE      	CLOSEIT3: CP	(HL)		;if neither one of these bytes were zero,
2834:	F0E2  C21FF1  		JP	NZ,CLOSEIT7	;then close error if they are not the same.
2835:	F0E5  C3FDF0  		JP	CLOSEIT5	;ok so far, get to next byte in fcbs.
2836:	F0E8  CD94F0  	CLOSEIT4: CALL	MOVEWORD	;update users fcb if it is zero.
2837:	F0EB  EB      		EX	DE,HL
2838:	F0EC  CD94F0  		CALL	MOVEWORD	;update directories fcb if it is zero.
2839:	F0EF  EB      		EX	DE,HL
2840:	F0F0  1A      		LD	A,(DE)		;if these two values are no different,
2841:	F0F1  BE      		CP	(HL)		;then a close error occured.
2842:	F0F2  C21FF1  		JP	NZ,CLOSEIT7
2843:	F0F5  13      		INC	DE		;check second byte.
2844:	F0F6  23      		INC	HL
2845:	F0F7  1A      		LD	A,(DE)
2846:	F0F8  BE      		CP	(HL)
2847:	F0F9  C21FF1  		JP	NZ,CLOSEIT7
2848:	F0FC  0D      		DEC	C		;remember 16 bit values.
2849:	F0FD  13      	CLOSEIT5: INC	DE		;bump to next item in table.
2850:	F0FE  23      		INC	HL
2851:	F0FF  0D      		DEC	C		;there are 16 entries only.
2852:	F100  C2CDF0  		JP	NZ,CLOSEIT1	;continue if more to do.
2853:	F103  01ECFF  		LD	BC,0FFECH	;backup 20 places (extent byte).
2854:	F106  09      		ADD	HL,BC
2855:	F107  EB      		EX	DE,HL
2856:	F108  09      		ADD	HL,BC
2857:	F109  1A      		LD	A,(DE)
2858:	F10A  BE      		CP	(HL)		;directory's extent already greater than the
2859:	F10B  DA17F1  		JP	C,CLOSEIT6	;users extent?
2860:	F10E  77      		LD	(HL),A		;no, update directory extent.
2861:	F10F  010300  		LD	BC,3		;and update the record count byte in
2862:	F112  09      		ADD	HL,BC		;directories fcb.
2863:	F113  EB      		EX	DE,HL
2864:	F114  09      		ADD	HL,BC
2865:	F115  7E      		LD	A,(HL)		;get from user.
2866:	F116  12      		LD	(DE),A		;and put in directory.
2867:	F117  3EFF    	CLOSEIT6: LD	A,0FFH		;set 'was open and is now closed' byte.
2868:	F119  32D2F5  		LD	(CLOSEFLG),A
2869:	F11C  C310F0  		JP	UPDATE1		;update the directory now.
2870:	F11F  2145EB  	CLOSEIT7: LD	HL,STATUS	;set return status and then return.
2871:	F122  35      		DEC	(HL)
2872:	F123  C9      		RET	
2873:			;
2874:			;   Routine to get the next empty space in the directory. It
2875:			; will then be cleared for use.
2876:			;
2877:	F124  CD54ED  	GETEMPTY: CALL	CHKWPRT		;make sure disk is not write protected.
2878:	F127  2A43EB  		LD	HL,(PARAMS)	;save current parameters (fcb).
2879:	F12A  E5      		PUSH	HL
2880:	F12B  21ACF5  		LD	HL,EMPTYFCB	;use special one for empty space.
2881:	F12E  2243EB  		LD	(PARAMS),HL
2882:	F131  0E01    		LD	C,1		;search for first empty spot in directory.
2883:	F133  CD18EF  		CALL	FINDFST		;(* only check first byte *)
2884:	F136  CDF5ED  		CALL	CKFILPOS	;none?
2885:	F139  E1      		POP	HL
2886:	F13A  2243EB  		LD	(PARAMS),HL	;restore original fcb address.
2887:	F13D  C8      		RET	Z		;return if no more space.
2888:	F13E  EB      		EX	DE,HL
2889:	F13F  210F00  		LD	HL,15		;point to number of records for this file.
2890:	F142  19      		ADD	HL,DE
2891:	F143  0E11    		LD	C,17		;and clear all of this space.
2892:	F145  AF      		XOR	A
2893:	F146  77      	GETMT1:	LD	(HL),A
2894:	F147  23      		INC	HL
2895:	F148  0D      		DEC	C
2896:	F149  C246F1  		JP	NZ,GETMT1
2897:	F14C  210D00  		LD	HL,13		;clear the 's1' byte also.
2898:	F14F  19      		ADD	HL,DE
2899:	F150  77      		LD	(HL),A
2900:	F151  CD8CED  		CALL	CHKNMBR		;keep (SCRATCH1) within bounds.
2901:	F154  CDFDEF  		CALL	FCBSET		;write out this fcb entry to directory.
2902:	F157  C378ED  		JP	SETS2B7		;set 's2' byte bit 7 (unmodified at present).
2903:			;
2904:			;   Routine to close the current extent and open the next one
2905:			; for reading.
2906:			;
2907:	F15A  AF      	GETNEXT:XOR	A
2908:	F15B  32D2F5  		LD	(CLOSEFLG),A	;clear close flag.
2909:	F15E  CDA2F0  		CALL	CLOSEIT		;close this extent.
2910:	F161  CDF5ED  		CALL	CKFILPOS
2911:	F164  C8      		RET	Z		;not there???
2912:	F165  2A43EB  		LD	HL,(PARAMS)	;get extent byte.
2913:	F168  010C00  		LD	BC,12
2914:	F16B  09      		ADD	HL,BC
2915:	F16C  7E      		LD	A,(HL)		;and increment it.
2916:	F16D  3C      		INC	A
2917:	F16E  E61F    		AND	1FH		;keep within range 0-31.
2918:	F170  77      		LD	(HL),A
2919:	F171  CA83F1  		JP	Z,GTNEXT1	;overflow?
2920:	F174  47      		LD	B,A		;mask extent byte.
2921:	F175  3AC5F5  		LD	A,(EXTMASK)
2922:	F178  A0      		AND	B
2923:	F179  21D2F5  		LD	HL,CLOSEFLG	;check close flag (0ffh is ok).
2924:	F17C  A6      		AND	(HL)
2925:	F17D  CA8EF1  		JP	Z,GTNEXT2	;if zero, we must read in next extent.
2926:	F180  C3ACF1  		JP	GTNEXT3		;else, it is already in memory.
2927:	F183  010200  	GTNEXT1:LD	BC,2		;Point to the 's2' byte.
2928:	F186  09      		ADD	HL,BC
2929:	F187  34      		INC	(HL)		;and bump it.
2930:	F188  7E      		LD	A,(HL)		;too many extents?
2931:	F189  E60F    		AND	0FH
2932:	F18B  CAB6F1  		JP	Z,GTNEXT5	;yes, set error code.
2933:			;
2934:			;   Get here to open the next extent.
2935:			;
