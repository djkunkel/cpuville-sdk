2096:	ED3B  23      		INC	HL		;remember the last one.
2097:	ED3C  EB      		EX	DE,HL
2098:	ED3D  2AB3F5  		LD	HL,(SCRATCH1)	;and store it here.
2099:	ED40  73      		LD	(HL),E		;put low byte.
2100:	ED41  23      		INC	HL
2101:	ED42  72      		LD	(HL),D		;then high byte.
2102:	ED43  C9      		RET	
2103:			;
2104:			;   Check for a read only file.
2105:			;
2106:	ED44  CD5EED  	CHKROFL:CALL	FCB2HL		;set (HL) to file entry in directory buffer.
2107:	ED47  110900  	CKROF1:	LD	DE,9		;look at bit 7 of the ninth byte.
2108:	ED4A  19      		ADD	HL,DE
2109:	ED4B  7E      		LD	A,(HL)
2110:	ED4C  17      		RLA	
2111:	ED4D  D0      		RET	NC		;return if ok.
2112:	ED4E  210FE8  		LD	HL,ROFILE	;else, print error message and terminate.
2113:	ED51  C34AEB  		JP	JUMPHL
2114:			;
2115:			;   Check the write protect status of the active disk.
2116:			;
