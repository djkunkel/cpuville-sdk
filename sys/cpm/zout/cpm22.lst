3070:	F295  2AE7F5  		LD	HL,(LOGSECT)	;get sector that starts current block.
3071:	F298  0E02    		LD	C,2		;set 'writing to unused space' flag.
3072:	F29A  22E5F5  	WTSEQ8:	LD	(BLKNMBR),HL	;save sector to write.
3073:	F29D  C5      		PUSH	BC
