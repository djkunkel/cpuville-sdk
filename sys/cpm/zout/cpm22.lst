2005:	ECD1  C9      		RET	
2006:			;
2007:			;   Set the next record to access. If (MODE) is set to 2, then
2008:			; the last record byte (SAVNREC) has the correct number to access.
2009:			; For sequential access, (MODE) will be equal to 1.
2010:			;
2011:	ECD2  CDAEEC  	SETNREC:CALL	SETHLDE
2012:	ECD5  3AD5F5  		LD	A,(MODE)	;get sequential flag (=1).
2013:	ECD8  FE02    		CP	2		;a 2 indicates that no adder is needed.
2014:	ECDA  C2DEEC  		JP	NZ,STNREC1
2015:	ECDD  AF      		XOR	A		;clear adder (random access?).
2016:	ECDE  4F      	STNREC1:LD	C,A
2017:	ECDF  3AE3F5  		LD	A,(SAVNREC)	;get last record number.
2018:	ECE2  81      		ADD	A,C		;increment record count.
2019:	ECE3  77      		LD	(HL),A		;and set fcb's next record byte.
2020:	ECE4  EB      		EX	DE,HL
2021:	ECE5  3AE1F5  		LD	A,(SAVNXT)	;get next record byte from storage.
2022:	ECE8  77      		LD	(HL),A		;and put this into fcb as number of records used.
2023:	ECE9  C9      		RET	
2024:			;
2025:			;   Shift (HL) right (C) bits.
2026:			;
2027:	ECEA  0C      	SHIFTR:	INC	C
2028:	ECEB  0D      	SHIFTR1:DEC	C
2029:	ECEC  C8      		RET	Z
2030:	ECED  7C      		LD	A,H
2031:	ECEE  B7      		OR	A
2032:	ECEF  1F      		RRA	
2033:	ECF0  67      		LD	H,A
2034:	ECF1  7D      		LD	A,L
2035:	ECF2  1F      		RRA	
2036:	ECF3  6F      		LD	L,A
2037:	ECF4  C3EBEC  		JP	SHIFTR1
2038:			;
2039:			;   Compute the check-sum for the directory buffer. Return
2040:			; integer sum in (A).
2041:			;
2042:	ECF7  0E80    	CHECKSUM: LD	C,128		;length of buffer.
2043:	ECF9  2AB9F5  		LD	HL,(DIRBUF)	;get its location.
2044:	ECFC  AF      		XOR	A		;clear summation byte.
2045:	ECFD  86      	CHKSUM1:ADD	A,(HL)	;and compute sum ignoring carries.
2046:	ECFE  23      		INC	HL
2047:	ECFF  0D      		DEC	C
2048:	ED00  C2FDEC  		JP	NZ,CHKSUM1
2049:	ED03  C9      		RET	
2050:			;
2051:			;   Shift (HL) left (C) bits.
2052:			;
