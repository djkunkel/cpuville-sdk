	      20
1319:	E8E1  522F4F24	DISKRO:	DEFB	'R/O$'
1320:			;
1321:			;   Print bdos error message.
1322:			;
1323:	E8E5  E5      	PRTERR:	PUSH	HL		;save second message pointer.
1324:	E8E6  CDC9E9  		CALL	OUTCRLF		;send (cr)(lf).
1325:	E8E9  3A42EB  		LD	A,(ACTIVE)	;get active drive.
1326:	E8EC  C641    		ADD	A,'A'		;make ascii.
1327:	E8EE  32C6E8  		LD	(BDOSDRV),A	;and put in message.
1328:	E8F1  01BAE8  		LD	BC,BDOSERR	;and print it.
1329:	E8F4  CDD3E9  		CALL	PRTMESG
1330:	E8F7  C1      		POP	BC		;print second message line now.
1331:	E8F8  CDD3E9  		CALL	PRTMESG
1332:			;
1333:			;   Get an input character. We will check our 1 character
1334:			; buffer first. This may be set by the console status routine.
1335:			;
1336:	E8FB  210EEB  	GETCHAR:LD	HL,CHARBUF	;check character buffer.
1337:	E8FE  7E      		LD	A,(HL)		;anything present already?
1338:	E8FF  3600    		LD	(HL),0		;...either case clear it.
1339:	E901  B7      		OR	A
1340:	E902  C0      		RET	NZ		;yes, use it.
1341:	E903  C309F6  		JP	CONIN		;nope, go get a character responce.
1342:			;
1343:			;   Input and echo a character.
1344:			;
1345:	E906  CDFBE8  	GETECHO:CALL	GETCHAR		;input a character.
1346:	E909  CD14E9  		CALL	CHKCHAR		;carriage control?
1347:	E90C  D8      		RET	C		;no, a regular control char so don't echo.
1348:	E90D  F5      		PUSH	AF		;ok, save character now.
1349:	E90E  4F      		LD	C,A
1350:	E90F  CD90E9  		CALL	OUTCON		;and echo it.
1351:	E912  F1      		POP	AF		;get character and return.
1352:	E913  C9      		RET	
1353:			;
1354:			;   Check character in (A). Set the zero flag on a carriage
1355:			; control character and the carry flag on any other control
1356:			; character.
1357:			;
1358:	E914  FE0D    	CHKCHAR:CP	CR		;check for carriage return, line feed, backspace,
1359:	E916  C8      		RET	Z		;or a tab.
1360:	E917  FE0A    		CP	LF
1361:	E919  C8      		RET	Z
1362:	E91A  FE09    		CP	TAB
1363:	E91C  C8      		RET	Z
1364:	E91D  FE08    		CP	BS
1365:	E91F  C8      		RET	Z
1366:	E920  FE20    		CP	' '		;other control char? Set carry flag.
1367:	E922  C9      		RET	
1368:			;
1369:			;   Check the console during output. Halt on a control-s, then
1370:			; reboot on a control-c. If anything else is ready, clear the
1371:			; zero flag and return (the calling routine may want to do
1372:			; something).
1373:			;
1374:	E923  3A0EEB  	CKCONSOL: LD	A,(CHARBUF)	;check buffer.
1375:	E926  B7      		OR	A		;if anything, just return without checking.
1376:	E927  C245E9  		JP	NZ,CKCON2
1377:	E92A  CD06F6  		CALL	CONST		;nothing in buffer. Check console.
1378:	E92D  E601    		AND	01H		;look at bit 0.
1379:	E92F  C8      		RET	Z		;return if nothing.
1380:	E930  CD09F6  		CALL	CONIN		;ok, get it.
1381:	E933  FE13    		CP	CNTRLS		;if not control-s, return with zero cleared.
1382:	E935  C242E9  		JP	NZ,CKCON1
1383:	E938  CD09F6  		CALL	CONIN		;halt processing until another char
1384:	E93B  FE03    		CP	CNTRLC		;is typed. Control-c?
1385:	E93D  CA0000  		JP	Z,0		;yes, reboot now.
1386:	E940  AF      		XOR	A		;no, just pretend nothing was ever ready.
1387:	E941  C9      		RET	
1388:	E942  320EEB  	CKCON1:	LD	(CHARBUF),A	;save character in buffer for later processing.
1389:	E945  3E01    	CKCON2:	LD	A,1		;set (A) to non zero to mean something is ready.
1390:	E947  C9      		RET	
1391:			;
1392:			;   Output (C) to the screen. If the printer flip-flop flag
1393:			; is set, we will send character to printer also. The console
1394:			; will be checked in the process.
1395:			;
