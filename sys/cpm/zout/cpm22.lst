2056:	ED07  29      		ADD	HL,HL		;shift left 1 bit.
2057:	ED08  C305ED  		JP	SHIFTL1
2058:			;
2059:			;   Routine to set a bit in a 16 bit value contained in (BC).
2060:			; The bit set depends on the current drive selection.
2061:			;
