2131:	ED65  6F      		LD	L,A
2132:	ED66  D0      		RET	NC
2133:	ED67  24      		INC	H		;take care of any carry.
2134:	ED68  C9      		RET	
2135:			;
2136:			;   Routine to get the 's2' byte from the fcb supplied in
2137:			; the initial parameter specification.
2138:			;
2139:	ED69  2A43EB  	GETS2:	LD	HL,(PARAMS)	;get address of fcb.
2140:	ED6C  110E00  		LD	DE,14		;relative position of 's2'.
2141:	ED6F  19      		ADD	HL,DE
2142:	ED70  7E      		LD	A,(HL)		;extract this byte.
2143:	ED71  C9      		RET	
2144:			;
2145:			;   Clear the 's2' byte in the fcb.
2146:			;
