2118:	ED57  C8      		RET	Z		;return if ok.
2119:	ED58  210DE8  		LD	HL,RODISK	;else print message and terminate.
2120:	ED5B  C34AEB  		JP	JUMPHL
2121:			;
2122:			;   Routine to set (HL) pointing to the proper entry in the
2123:			; directory buffer.
2124:			;
2125:	ED5E  2AB9F5  	FCB2HL:	LD	HL,(DIRBUF)	;get address of buffer.
2126:	ED61  3AE9F5  		LD	A,(FCBPOS)	;relative position of file.
2127:			;
2128:			;   Routine to add (A) to (HL).
2129:			;
