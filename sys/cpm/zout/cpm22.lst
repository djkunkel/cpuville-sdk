1852:	EC0A  E1      		POP	HL		;and continue until it is.
1853:	EC0B  23      		INC	HL
1854:	EC0C  C3FAEB  		JP	TRKSEC3
1855:			;
1856:			;   here we have determined the track number that contains the
1857:			; desired sector.
1858:			;
1859:	EC0F  E1      	TRKSEC4:POP	HL		;get track number (HL).
1860:	EC10  C5      		PUSH	BC
1861:	EC11  D5      		PUSH	DE
1862:	EC12  E5      		PUSH	HL
1863:	EC13  EB      		EX	DE,HL
1864:	EC14  2ACEF5  		LD	HL,(OFFSET)	;adjust for first track offset.
1865:	EC17  19      		ADD	HL,DE
1866:	EC18  44      		LD	B,H
1867:	EC19  4D      		LD	C,L
1868:	EC1A  CD1EF6  		CALL	SETTRK		;select this track.
1869:	EC1D  D1      		POP	DE		;reset current track pointer.
1870:	EC1E  2AB5F5  		LD	HL,(SCRATCH2)
1871:	EC21  73      		LD	(HL),E
1872:	EC22  23      		INC	HL
1873:	EC23  72      		LD	(HL),D
1874:	EC24  D1      		POP	DE
1875:	EC25  2AB7F5  		LD	HL,(SCRATCH3)	;reset the first sector on this track.
1876:	EC28  73      		LD	(HL),E
1877:	EC29  23      		INC	HL
1878:	EC2A  72      		LD	(HL),D
1879:	EC2B  C1      		POP	BC
1880:	EC2C  79      		LD	A,C		;now subtract the desired one.
1881:	EC2D  93      		SUB	E		;to make it relative (1-# sectors/track).
1882:	EC2E  4F      		LD	C,A
1883:	EC2F  78      		LD	A,B
1884:	EC30  9A      		SBC	A,D
1885:	EC31  47      		LD	B,A
1886:	EC32  2AD0F5  		LD	HL,(XLATE)	;translate this sector according to this table.
1887:	EC35  EB      		EX	DE,HL
1888:	EC36  CD30F6  		CALL	SECTRN		;let the bios translate it.
1889:	EC39  4D      		LD	C,L
1890:	EC3A  44      		LD	B,H
1891:	EC3B  C321F6  		JP	SETSEC		;and select it.
1892:			;
1893:			;   Compute block number from record number (SAVNREC) and
1894:			; extent number (SAVEXT).
1895:			;
1896:	EC3E  21C3F5  	GETBLOCK: LD	HL,BLKSHFT	;get logical to physical conversion.
1897:	EC41  4E      		LD	C,(HL)		;note that this is base 2 log of ratio.
1898:	EC42  3AE3F5  		LD	A,(SAVNREC)	;get record number.
1899:	EC45  B7      	GETBLK1:OR	A		;compute (A)=(A)/2^BLKSHFT.
1900:	EC46  1F      		RRA	
1901:	EC47  0D      		DEC	C
1902:	EC48  C245EC  		JP	NZ,GETBLK1
1903:	EC4B  47      		LD	B,A		;save result in (B).
1904:	EC4C  3E08    		LD	A,8
1905:	EC4E  96      		SUB	(HL)
1906:	EC4F  4F      		LD	C,A		;compute (C)=8-BLKSHFT.
1907:	EC50  3AE2F5  		LD	A,(SAVEXT)
1908:	EC53  0D      	GETBLK2:DEC	C		;compute (A)=SAVEXT*2^(8-BLKSHFT).
1909:	EC54  CA5CEC  		JP	Z,GETBLK3
1910:	EC57  B7      		OR	A
1911:	EC58  17      		RLA	
1912:	EC59  C353EC  		JP	GETBLK2
1913:	EC5C  80      	GETBLK3:ADD	A,B
1914:	EC5D  C9      		RET	
1915:			;
1916:			;   Routine to extract the (BC) block byte from the fcb pointed
1917:			; to by (PARAMS). If this is a big-disk, then these are 16 bit
1918:			; block numbers, else they are 8 bit numbers.
1919:			; Number is returned in (HL).
1920:			;
1921:	EC5E  2A43EB  	EXTBLK:	LD	HL,(PARAMS)	;get fcb address.
1922:	EC61  111000  		LD	DE,16		;block numbers start 16 bytes into fcb.
1923:	EC64  19      		ADD	HL,DE
1924:	EC65  09      		ADD	HL,BC
1925:	EC66  3ADDF5  		LD	A,(BIGDISK)	;are we using a big-disk?
1926:	EC69  B7      		OR	A
1927:	EC6A  CA71EC  		JP	Z,EXTBLK1
