3152:	F304  32D5F5  		LD	(MODE),A
3153:			;
3154:			;   Special entry (function #40). M/PM ?
3155:			;
3156:	F307  C5      	POSITN1:PUSH	BC		;save read/write flag.
3157:	F308  2A43EB  		LD	HL,(PARAMS)	;get address of fcb.
3158:	F30B  EB      		EX	DE,HL
3159:	F30C  212100  		LD	HL,33		;now get byte 'r0'.
3160:	F30F  19      		ADD	HL,DE
3161:	F310  7E      		LD	A,(HL)
3162:	F311  E67F    		AND	7FH		;keep bits 0-6 for the record number to access.
3163:	F313  F5      		PUSH	AF
3164:	F314  7E      		LD	A,(HL)		;now get bit 7 of 'r0' and bits 0-3 of 'r1'.
3165:	F315  17      		RLA	
3166:	F316  23      		INC	HL
3167:	F317  7E      		LD	A,(HL)
3168:	F318  17      		RLA	
3169:	F319  E61F    		AND	1FH		;and save this in bits 0-4 of (C).
3170:	F31B  4F      		LD	C,A		;this is the extent byte.
3171:	F31C  7E      		LD	A,(HL)		;now get the extra extent byte.
3172:	F31D  1F      		RRA	
3173:	F31E  1F      		RRA	
3174:	F31F  1F      		RRA	
3175:	F320  1F      		RRA	
3176:	F321  E60F    		AND	0FH
3177:	F323  47      		LD	B,A		;and save it in (B).
3178:	F324  F1      		POP	AF		;get record number back to (A).
3179:	F325  23      		INC	HL		;check overflow byte 'r2'.
3180:	F326  6E      		LD	L,(HL)
3181:	F327  2C      		INC	L
3182:	F328  2D      		DEC	L
3183:	F329  2E06    		LD	L,6		;prepare for error.
3184:	F32B  C28BF3  		JP	NZ,POSITN5	;out of disk space error.
3185:	F32E  212000  		LD	HL,32		;store record number into fcb.
3186:	F331  19      		ADD	HL,DE
3187:	F332  77      		LD	(HL),A
3188:	F333  210C00  		LD	HL,12		;and now check the extent byte.
3189:	F336  19      		ADD	HL,DE
3190:	F337  79      		LD	A,C
3191:	F338  96      		SUB	(HL)		;same extent as before?
3192:	F339  C247F3  		JP	NZ,POSITN2
