3212:	F35A  19      		ADD	HL,DE
3213:	F35B  71      		LD	(HL),C
3214:	F35C  210E00  		LD	HL,14		;and store extra extent byte 's2'.
3215:	F35F  19      		ADD	HL,DE
3216:	F360  70      		LD	(HL),B
3217:	F361  CD51F0  		CALL	OPENIT		;try and get this extent.
3218:	F364  3A45EB  		LD	A,(STATUS)	;was it there?
3219:	F367  3C      		INC	A
3220:	F368  C27FF3  		JP	NZ,POSITN3
3221:	F36B  C1      		POP	BC		;no. can we create a new one (writing?).
3222:	F36C  C5      		PUSH	BC
3223:	F36D  2E04    		LD	L,4		;prepare for error.
3224:	F36F  0C      		INC	C
3225:	F370  CA84F3  		JP	Z,POSITN4	;nope, reading unwritten space error.
3226:	F373  CD24F1  		CALL	GETEMPTY	;yes we can, try to find space.
3227:	F376  2E05    		LD	L,5		;prepare for error.
3228:	F378  3A45EB  		LD	A,(STATUS)
