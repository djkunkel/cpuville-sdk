1294:			;
1295:			;   Bdos error message section.
1296:			;
1297:	E899  21CAE8  	ERROR1:	LD	HL,BADSEC	;bad sector message.
1298:	E89C  CDE5E8  		CALL	PRTERR		;print it and get a 1 char responce.
1299:	E89F  FE03    		CP	CNTRLC		;re-boot request (control-c)?
1300:	E8A1  CA0000  		JP	Z,0		;yes.
1301:	E8A4  C9      		RET			;no, return to retry i/o function.
1302:			;
1303:	E8A5  21D5E8  	ERROR2:	LD	HL,BADSEL	;bad drive selected.
1304:	E8A8  C3B4E8  		JP	ERROR5
1305:			;
