1151:	E730  7E      	UNKWN5:	LD	A,(HL)		;line down to (0080h). Look for a non blank.
1152:	E731  B7      		OR	A		;or a null.
1153:	E732  CA3EE7  		JP	Z,UNKWN6
1154:	E735  FE20    		CP	' '
1155:	E737  CA3EE7  		JP	Z,UNKWN6
