3059:	F282  3D      		DEC	A
3060:	F283  3D      		DEC	A
3061:	F284  C2BBF2  		JP	NZ,WTSEQ9
3062:	F287  E5      		PUSH	HL
3063:	F288  2AB9F5  		LD	HL,(DIRBUF)	;zero out the directory buffer.
3064:	F28B  57      		LD	D,A		;note that (A) is zero here.
3065:	F28C  77      	WTSEQ7:	LD	(HL),A
