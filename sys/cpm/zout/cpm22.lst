1952:	EC89  C9      		RET	
1953:			;
1954:			;   Adjust physical block (BLKNMBR) and convert to logical
1955:			; sector (LOGSECT). This is the starting sector of this block.
1956:			; The actual sector of interest is then added to this and the
1957:			; resulting sector number is stored back in (BLKNMBR). This
1958:			; will still have to be adjusted for the track number.
1959:			;
1960:	EC8A  3AC3F5  	LOGICAL:LD	A,(BLKSHFT)	;get log2(physical/logical sectors).
1961:	EC8D  2AE5F5  		LD	HL,(BLKNMBR)	;get physical sector desired.
1962:	EC90  29      	LOGICL1:ADD	HL,HL		;compute logical sector number.
1963:	EC91  3D      		DEC	A		;note logical sectors are 128 bytes long.
1964:	EC92  C290EC  		JP	NZ,LOGICL1
1965:	EC95  22E7F5  		LD	(LOGSECT),HL	;save logical sector.
1966:	EC98  3AC4F5  		LD	A,(BLKMASK)	;get block mask.
1967:	EC9B  4F      		LD	C,A
1968:	EC9C  3AE3F5  		LD	A,(SAVNREC)	;get next sector to access.
1969:	EC9F  A1      		AND	C		;extract the relative position within physical block.
1970:	ECA0  B5      		OR	L		;and add it too logical sector.
1971:	ECA1  6F      		LD	L,A
1972:	ECA2  22E5F5  		LD	(BLKNMBR),HL	;and store.
1973:	ECA5  C9      		RET	
1974:			;
1975:			;   Set (HL) to point to extent byte in fcb.
1976:			;
1977:	ECA6  2A43EB  	SETEXT:	LD	HL,(PARAMS)
1978:	ECA9  110C00  		LD	DE,12		;it is the twelth byte.
1979:	ECAC  19      		ADD	HL,DE
1980:	ECAD  C9      		RET	
1981:			;
1982:			;   Set (HL) to point to record count byte in fcb and (DE) to
1983:			; next record number byte.
1984:			;
1985:	ECAE  2A43EB  	SETHLDE:LD	HL,(PARAMS)
