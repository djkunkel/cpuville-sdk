1934:	EC74  56      		LD	D,(HL)
1935:	EC75  EB      		EX	DE,HL		;return in (HL).
1936:	EC76  C9      		RET	
1937:			;
1938:			;   Compute block number.
1939:			;
1940:	EC77  CD3EEC  	COMBLK:	CALL	GETBLOCK
1941:	EC7A  4F      		LD	C,A
1942:	EC7B  0600    		LD	B,0
