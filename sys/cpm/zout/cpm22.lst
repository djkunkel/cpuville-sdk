2083:	ED28  7D      		LD	A,L		;one of interest for this drive.
2084:	ED29  E601    		AND	01H		;and isolate it.
2085:	ED2B  C9      		RET	
2086:			;
2087:			;   Function to write protect the current disk.
2088:			;
2089:	ED2C  21ADF5  	WRTPRTD:LD	HL,WRTPRT	;point to status word.
