   1:				;
   2:				;  PCGET - This CP/M program receives a file from a PC via a serial 
   3:				;  port and writes it to a file on the CP/M system. The file transfer uses
   4:				;  the XMODEM protocol. 
   5:				;
   6:				;  Note this program is gutted from the Ward Christenson Modem program.
   7:				;
   8:				;  Hacked together by Mike Douglas for the Altair 2SIO serial interface board.
   9:				;	Ver	Date	Desc
  10:				;	1.0    11/7/12	Initial version
  11:				;	1.1    2/20/14  Allow transfer to occur over 2SIO port B
  12:				;	1.2   12/21/14	Send NAK immediately after file open to speed
  13:				;			up the start-up of file transfer (four second
  14:				;			delay otherwise).
  15:				;	2.0	5/11/17	Update for CPUVille system
  16:				;  Serial Port Equates
  17:				
  18:     -	0003          	SIOACR:	.EQU	003H		;2SIO port A control register
  19:     -	0002          	SIOADR:	.EQU	002H		;2SIO port A data register
  20:     -	0012          	SIOBCR:	.EQU	012H		;2SIO port B control register
  21:     -	0013          	SIOBDR	.EQU	013H		;2SIO port B data register
  22:				
  23:     -	0001          	XMTMASK:	.EQU	1		;MASK TO ISOLATE XMIT READY BIT
  24:     -	0001          	XMTRDY:	.EQU	1		;VALUE WHEN READY
  25:     -	0002          	RCVMASK:	.EQU	2		;MASK TO ISOLATE RECEIVE READY BIT
  26:     -	0002          	RCVRDY:	.EQU	2		;BIT ON WHEN READY
  27:				
  28:				;  Transfer related equates
  29:				
  30:     -	0001          	SOH:	.EQU	1
  31:     -	0004          	EOT:	.EQU	4
  32:     -	0006          	ACK:	.EQU	6
  33:     -	0015          	NAK:	.EQU	15H
  34:     -	0003          	CTRLC:	.EQU	3		;Control-C
  35:     -	000A          	LF:	.EQU	10
  36:     -	000D          	CR:	.EQU	13
  37:				
  38:     -	0100          		.ORG	100H
  39:				
  40:				;  Verify a file name was specified
  41:				
  42:    0+13	0100  3A5D00  		lda	PARAM1		;A=1st character of parameter 1
