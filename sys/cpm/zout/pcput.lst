  54:				;  doXfer - Switch to local stack and do the transfer
  55:				
  56:     -	0111          	doXfer:
  57:				
  58:   74+10	0111  210000  		LXI	H,0		;HL=0
  59:   84+10	0114  39      		DAD	SP		;HL=STACK FROM CP/M
  60:   94+16	0115  22D403  		SHLD	STACK		;..SAVE IT
  61:  110+10	0118  31D403  		LXI	SP,STACK	;SP=MY STACK
  62:  120+4	011B  AF      		xra	a		
  63:  124+13	011C  32D603  		sta	SECTNO		;initialize sector number to zero
  64:  137+17	011F  CDBB01  		CALL	OPEN_FILE	;OPEN THE FILE
  65:  154+17	0122  CD2802  		CALL	INIT_ACIA	;MASTER RESET THE ACIA
  66:  171+10	0125  110403  		lxi	d,mRcvA		;assume using port A
  67:  181+7	0128  0E09    	sendA	MVI	C,PRINT
  68:  188+17	012A  CD0500  		CALL	BDOS		;PRINT ID MESSAGE
  69:				
  70:				;  GOBBLE UP GARBAGE CHARS FROM THE LINE
  71:				
  72:  205+7	012D  0601    	purge	MVI	B,1		;times out after 1 second if no data
  73:  212+17	012F  CDEA01  		CALL	RECV
  74:  229+10	0132  DA3D01  		jc	lineClr		;line is clear, go wait for initial NAK
  75:  239+7	0135  FE03    		cpi	CTRLC		;exit if abort requested
  76:  246+10	0137  CACB02  		jz	abort
  77:  256+10	013A  C32D01  		jmp	purge
  78:				
  79:				; WAIT FOR INITIAL NAK, THEN SEND THE FILE
  80:					
  81:  266+4	013D  AF      	lineClr	xra	a		;clear crc flag = checksum mode
  82:  270+13	013E  32D803  		sta	crcFlag
  83:  283+7	0141  0601    	WAITNAK	MVI	B,1		;TIMEOUT DELAY
  84:  290+17	0143  CDEA01  		CALL	RECV
  85:  307+10	0146  DA4101  		JC	WAITNAK
  86:  317+7	0149  FE03    		cpi	CTRLC		;abort requested?
  87:  324+10	014B  CACB02  		jz	abort
  88:  334+7	014E  FE15    		CPI	NAK		;NAK RECEIVED?
  89:  341+10	0150  CA5B01  		jz	SENDB		;yes, send file in checksum mode
  90:  351+7	0153  FE43    		cpi	'C'		;'C' for CRC mode received?
  91:  358+10	0155  C24101  		JNZ	WAITNAK		;no, keep waiting
  92:  368+13	0158  32D803  		sta	crcFlag		;set CRC flag non-zero = true
  93:								;fall through to start the send operation
