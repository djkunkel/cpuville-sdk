 309:				
 310:				;-----------------------------------------------------------------------------
 311:				; calCrc - update the 16-bit CRC with one more byte. 
 312:				;    (Copied from M. Eberhard)
 313:				; On Entry:
 314:				;   a has the new byte
 315:				;   crc16 is current except this byte
 316:				; On Exit:
 317:				;   crc16 has been updated
 318:				;   Trashes a,de
 319:				;-----------------------------------------------------------------------------
 320: 1571+11	02E4  C5      	calCrc	push	b		;save bc, hl
 321: 1582+11	02E5  E5      		push	h
 322: 1593+16	02E6  2AD903  		lhld	crc16		;get CRC so far
 323: 1609+4	02E9  AC      		xra	h		;XOR into CRC top byte
 324: 1613+5	02EA  67      		mov	h,a
 325: 1618+10	02EB  012110  		lxi	b,1021h		;bc=CRC16 polynomial
 326: 1628+7	02EE  1608    		mvi	d,8		;prepare to rotate 8 bits
 327:				
 328:				; do 8 bit shift/divide by CRC polynomial
 329:				
 330: 1635+10	02F0  29      	cRotLp	dad	h		;16-bit shift
 331: 1645+10	02F1  D2FA02  		jnc	cClr		;skip if bit 15 was 0
 332: 1655+5	02F4  7C      		mov	a,h		;CRC=CRC xor 1021H
 333: 1660+4	02F5  A8      		xra	b
 334: 1664+5	02F6  67      		mov	h,a
 335: 1669+5	02F7  7D      		mov	a,l
 336: 1674+4	02F8  A9      		xra	c
 337: 1678+5	02F9  6F      		mov	l,a
 338: 1683+5	02FA  15      	cClr	dcr	d
 339: 1688+10	02FB  C2F002  		jnz	cRotLp		;rotate 8 times
 340:				
 341:				; save the updated CRC and exit
 342:				
 343: 1698+16	02FE  22D903  		shld	crc16		;save updated CRC
 344: 1714+10	0301  E1      		pop	h		;restore hl, bc
 345: 1724+10	0302  C1      		pop	b
 346: 1734+10	0303  C9      		ret
