   1:				;
   2:				;  PCPUT - This CP/M program sends a file from the CP/M machine to a PC using
   3:				;	a serial port. The file transfer uses the XMODEM protocol. 
   4:				;
   5:				;  Note this program is gutted from the Ward Christenson Modem program.
   6:				;
   7:				;  Hacked together by Mike Douglas for the Altair 2SIO serial interface board.
   8:				;	Ver	Date	Desc
   9:				;	1.0    	11/8/12		Initial version
  10:				;	1.1    	2/20/14  	Allow transfer to occur over 2SIO port B
  11:				;	1.2   	12/21/14  	Support CRC as well as checksum
  12:				;	1.3   	10/16/15	Set initial CRC flag state in software. Was
  13:				;				previously random from load.
  14:				;	2.0	5/11/2017 	Update for CPUVille system
  15:				;
  16:				;  Serial Port Equates
  17:				
  18:     -	0003          	SIOACR	.EQU	003H		;2SIO port A control register
  19:     -	0002          	SIOADR	.EQU	002H		;2SIO port A data register
  20:     -	0012          	SIOBCR	.EQU	012H		;2SIO port B control register
  21:     -	0013          	SIOBDR	.EQU	013H		;2SIO port B data register
  22:				
  23:     -	0001          	XMTMASK	.EQU	1		;MASK TO GET XMIT READY BIT
  24:     -	0001          	XMTRDY	.EQU	1		;VALUE WHEN READY
  25:     -	0002          	RCVMASK	.EQU	2		;MASK TO GET RECEIVE DATA AVAILABLE
  26:     -	0002          	RCVRDY	.EQU	2		;BIT ON WHEN READY
  27:				
  28:     -	0005          	ERRLMT	.EQU	5		;MAX ALLOWABLE ERRORS
  29:				
  30:				;DEFINE ASCII CHARACTERS USED
  31:				
  32:     -	0001          	SOH	.EQU	1
  33:     -	0004          	EOT	.EQU	4
  34:     -	0006          	ACK	.EQU	6
  35:     -	0015          	NAK	.EQU	15H
  36:     -	0003          	CTRLC	.EQU	3		;Control-C
  37:     -	000A          	LF	.EQU	10
  38:     -	000D          	CR	.EQU	13
  39:				
  40:     -	0100          		.ORG	100h
  41:				
  42:				;  Verify a file name was specified
  43:				
  44:    0+13	0100  3A5D00  		lda	PARAM1		;A=1st character of parameter 1
  45:   13+7	0103  FE20    		cpi	' '		;make sure something entered
  46:   20+10	0105  C21101  		jnz	doXfer		;-found
  47:   30+10	0108  112503  		lxi	d,mHelp		;display usage message
  48:   40+7	010B  0E09    		mvi	c,PRINT
  49:   47+17	010D  CD0500  		call	BDOS
  50:   64+10	0110  C9      		ret			;return to CPM
  51:				
