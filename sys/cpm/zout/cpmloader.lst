   1:				;Retrieves CP/M image from disk and loads it in memory starting at E400h 
   2:				;Uses calls to ROM routine for disk read.
   3:				;Reads track 0, sectors 1 to 50
   4:				;This program is loaded into LBA sector 0 of disk, read to loc. 0800h by ROM and executed.
   5:     -	0900          	hstbuf: 	equ	0900h		;will put 256-byte raw sector here
   6:     -	0294          	disk_read:	equ	0294h		;in 2K ROM
   7:     -	F600          	cpm:		equ	0F600h		;CP/M cold start entry
   8:     -	0800          			org	0800h
   9:				;Read track 0, sectors 1 to 50
  10:    0+7	0800  3E01    			ld	a,1		;starting sector -- sector 0 has cpm_loader
  11:    7+13	0802  326E08  			ld	(sector),a
  12:   20+10	0805  2100E0  			ld	hl,0E000h	;memory address to place image
  13:   30+16	0808  227008  			ld	(dmaad),hl
  14:   46+7	080B  3E00    			ld	a,0		;CP/M track
  15:   53+13	080D  326F08  			ld	(track),a
