  22:  130+16	081F  2A7008  			ld	hl,(dmaad)
  23:  146+10	0822  118000  			ld	de,128
  24:  156+11	0825  19      			add	hl,de
  25:  167+16	0826  227008  			ld	(dmaad),hl
  26:  183+10	0829  C31008  			jp	rd_trk_0_loop
  27:  193+11	082C  D301    	done:	out	(1),a		;switch memory config to all-RAM
