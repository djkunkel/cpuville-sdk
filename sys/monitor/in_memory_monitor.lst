0ae0 2a 03 08					ld	hl,(current_location)	;location of start of line 
0ae3 7c						ld	a,h			;high byte of address 
0ae4 21 0b 08					ld	hl, buffer 
0ae7 cd 87 09					call	byte_to_hex_string	;convert 
0aea 21 0b 08					ld	hl,buffer 
0aed cd 17 09					call	write_string		;write high byte 
0af0 2a 03 08					ld	hl,(current_location) 
