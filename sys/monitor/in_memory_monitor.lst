0da4			;Simple monitor program for CPUville Z80 computer with serial interface. 
0da4 31 ff db		monitor_first_start: ld	sp,ROM_monitor_stack 
0da7 21 4f 0f							ld	hl,monitor_message 
0daa cd 17 09							call	write_string 
0dad cd 88 0b		monitor_warm_start: call	write_newline		 
0db0 3e 3e							ld	a,03eh			;cursor symbol 
0db2 cd 0b 09							call	write_char 
0db5 21 0b 08							ld	hl,buffer 
0db8 cd 4b 09							call	get_line		;get monitor input string (command) 
0dbb cd 88 0b							call	write_newline 
0dbe cd c2 0d							call	parse			;interprets command, returns with address to jump to in HL 
0dc1 e9								jp	(hl) 
0dc2			; 
0dc2			;Parses an input line stored in buffer for available commands as described in parse table. 
0dc2			;Returns with address of jump to action for the command in HL 
0dc2 01 d2 11		parse:			ld	bc,parse_table		;bc is pointer to parse_table 
0dc5 0a			parse_start:		ld	a,(bc)			;get pointer to match string from parse table 
0dc6 5f						ld	e,a 
0dc7 03						inc	bc 
0dc8 0a						ld	a,(bc)			 
0dc9 57						ld	d,a			;de will is pointer to strings for matching 
0dca 1a						ld	a,(de)			;get first char from match string 
0dcb f6 00					or	000h			;zero? 
0dcd ca e8 0d					jp	z,parser_exit		;yes, exit no_match 
0dd0 21 0b 08					ld	hl,buffer		;no, parse input string  
0dd3 be			match_loop:		cp	(hl)			;compare buffer char with match string char 
0dd4 c2 e2 0d					jp	nz,no_match		;no match, go to next match string 
0dd7 f6 00					or	000h			;end of strings (zero)? 
0dd9 ca e8 0d					jp	z,parser_exit		;yes, matching string found 
0ddc 13						inc	de			;match so far, point to next char in match string 
0ddd 1a						ld	a,(de)			;get next character from match string 
0dde 23						inc	hl			;and point to next char in input string 
0ddf c3 d3 0d					jp	match_loop		;check for match 
0de2 03			no_match:		inc	bc			;skip over jump target to 
0de3 03						inc	bc 
0de4 03						inc	bc			;get address of next matching string 
0de5 c3 c5 0d					jp	parse_start 
0de8 03			parser_exit:		inc	bc			;skip to address of jump for match 
0de9 0a						ld	a,(bc) 
0dea 6f						ld	l,a 
0deb 03						inc	bc 
0dec 0a						ld	a,(bc) 
0ded 67						ld	h,a			;returns with jump address in hl 
0dee c9						ret 
