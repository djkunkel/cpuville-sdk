0b93			; 
0b93			;Subroutine to read one disk sector (256 bytes) 
0b93			;Address to place data passed in HL 
0b93			;LBA bits 0 to 7 passed in C, bits 8 to 15 passed in B 
0b93			;LBA bits 16 to 23 passed in E 
0b93			disk_read: 
0b93 db 0f		rd_status_loop_1:	in	a,(0fh)		;check status 
0b95 e6 80					and	80h		;check BSY bit 
0b97 c2 93 0b					jp	nz,rd_status_loop_1	;loop until not busy 
0b9a db 0f		rd_status_loop_2:	in	a,(0fh)		;check	status 
0b9c e6 40					and	40h		;check DRDY bit 
0b9e ca 9a 0b					jp	z,rd_status_loop_2	;loop until ready 
0ba1 3e 01					ld	a,01h		;number of sectors = 1 
0ba3 d3 0a					out	(0ah),a		;sector count register 
0ba5 79						ld	a,c 
0ba6 d3 0b					out	(0bh),a		;lba bits 0 - 7 
0ba8 78						ld	a,b 
0ba9 d3 0c					out	(0ch),a		;lba bits 8 - 15 
0bab 7b						ld	a,e 
0bac d3 0d					out	(0dh),a		;lba bits 16 - 23 
0bae 3e e0					ld	a,11100000b	;LBA mode, select drive 0 
0bb0 d3 0e					out	(0eh),a		;drive/head register 
0bb2 3e 20					ld	a,20h		;Read sector command 
0bb4 d3 0f					out	(0fh),a 
0bb6 db 0f		rd_wait_for_DRQ_set:	in	a,(0fh)		;read status 
0bb8 e6 08					and	08h		;DRQ bit 
0bba ca b6 0b					jp	z,rd_wait_for_DRQ_set	;loop until bit set 
0bbd db 0f		rd_wait_for_BSY_clear:	in	a,(0fh) 
0bbf e6 80					and	80h 
0bc1 c2 bd 0b					jp	nz,rd_wait_for_BSY_clear 
0bc4 db 0f					in	a,(0fh)		;clear INTRQ 
0bc6 db 08		read_loop:		in	a,(08h)		;get data 
0bc8 77						ld	(hl),a 
0bc9 23						inc	hl 
0bca db 0f					in	a,(0fh)		;check status 
0bcc e6 08					and	08h		;DRQ bit 
0bce c2 c6 0b					jp	nz,read_loop	;loop until cleared 
0bd1 c9						ret 
0bd2			; 
0bd2			;Subroutine to write one disk sector (256 bytes) 
0bd2			;Address of data to write to disk passed in HL 
0bd2			;LBA bits 0 to 7 passed in C, bits 8 to 15 passed in B 
0bd2			;LBA bits 16 to 23 passed in E 
0bd2			disk_write: 
0bd2 db 0f		wr_status_loop_1:	in	a,(0fh)		;check status 
0bd4 e6 80					and	80h		;check BSY bit 
0bd6 c2 d2 0b					jp	nz,wr_status_loop_1	;loop until not busy 
0bd9 db 0f		wr_status_loop_2:	in	a,(0fh)		;check	status 
0bdb e6 40					and	40h		;check DRDY bit 
0bdd ca d9 0b					jp	z,wr_status_loop_2	;loop until ready 
0be0 3e 01					ld	a,01h		;number of sectors = 1 
0be2 d3 0a					out	(0ah),a		;sector count register 
0be4 79						ld	a,c 
0be5 d3 0b					out	(0bh),a		;lba bits 0 - 7 
0be7 78						ld	a,b 
0be8 d3 0c					out	(0ch),a		;lba bits 8 - 15 
0bea 7b						ld	a,e 
0beb d3 0d					out	(0dh),a		;lba bits 16 - 23 
0bed 3e e0					ld	a,11100000b	;LBA mode, select drive 0 
0bef d3 0e					out	(0eh),a		;drive/head register 
0bf1 3e 30					ld	a,30h		;Write sector command 
0bf3 d3 0f					out	(0fh),a 
0bf5 db 0f		wr_wait_for_DRQ_set:	in	a,(0fh)		;read status 
0bf7 e6 08					and	08h		;DRQ bit 
0bf9 ca f5 0b					jp	z,wr_wait_for_DRQ_set	;loop until bit set			 
0bfc 7e			write_loop:		ld	a,(hl) 
0bfd d3 08					out	(08h),a		;write data 
0bff 23						inc	hl 
0c00 db 0f					in	a,(0fh)		;read status 
0c02 e6 08					and	08h		;check DRQ bit 
0c04 c2 fc 0b					jp	nz,write_loop	;write until bit cleared 
0c07 db 0f		wr_wait_for_BSY_clear:	in	a,(0fh) 
0c09 e6 80					and	80h 
0c0b c2 07 0c					jp	nz,wr_wait_for_BSY_clear 
0c0e db 0f					in	a,(0fh)		;clear INTRQ 
0c10 c9						ret 
