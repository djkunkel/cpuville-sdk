# File in_memory_monitor.asm
0000			;ROM monitor for a system with serial interface and IDE disk and memory expansion board. 
0000			;The disk extension board has 64K RAM -- computer board memory decoder disabled (J2 off). 
0000			;The disk extension board uses ports 2 and 3 for the serial interface, and 8 to 15 for the disk 
0000			;Therefore the computer board I/O decoder is also disabled (J1 off) 
0000			;Output to port 0 will cause memory configuration flip-flop to activate 2K ROM 0000-07FF with 62K RAM 0800-FFFF 
0000			;Output to port 1 will cause memory configuration flip-flop to activate all RAM 0000-FFFF 
0000			; 
0000						org	00800h 
0800 c3 a4 0d					jp 	monitor_first_start			 
0803						 
0803			; 
0803			;The following code is for a system with a serial port. 
0803			;Assumes the UART data port address is 02h and control/status address is 03h 
0803			; 
0803			;The subroutines for the serial port use these variables in RAM: 
0803 00...		current_location:	defs 2		;word variable in RAM 
0805 00...		line_count:			defs 1		;byte variable in RAM 
0806 00...		byte_count:			defs 1		;byte variable in RAM 
0807 00...		value_pointer:		defs 2		;word variable in RAM 
0809 00...		current_value:		defs 2		;word variable in RAM 
080b 0x00...		buffer:				defs 247,0		;buffer in RAM  
0902			;Need to have stack in upper RAM, but not in area of CP/M or RAM monitor. 
0902			ROM_monitor_stack:	equ	0xdbff		;upper TPA in RAM, below RAM monitor 
0902			; 
0902			;Subroutine to initialize serial port UART 
0902			;Needs to be called only once after computer comes out of reset. 
0902			;If called while port is active will cause port to fail. 
0902			;16x = 9600 baud 
0902 3e 4e		initialize_port:	ld 	a,04eh			;1 stop bit, no parity, 8-bit char, 16x baud 
0904 d3 03					out 	(3),a			;write to control port 
0906 3e 37					ld 	a,037h			;enable receive and transmit 
0908 d3 03					out 	(3),a			;write to control port 
090a c9						ret 
090b			; 
090b			;Puts a single char (byte value) on serial output 
090b			;Call with char to send in A register. Uses B register 
090b 47			write_char:		ld	b,a			;store char 
090c db 03		write_char_loop:	in	a,(3)			;check if OK to send 
090e e6 01					and	001h			;check TxRDY bit 
0910 ca 0c 09					jp 	z,write_char_loop	;loop if not set 
0913 78						ld 	a,b			;get char back 
0914 d3 02					out 	(2),a			;send to output 
0916 c9						ret				;returns with char in a 
0917			; 
0917			;Subroutine to write a zero-terminated string to serial output 
0917			;Pass address of string in HL register 
0917			;No error checking 
0917 db 03		write_string:		in 	a,(3)			;read status 
0919 e6 01					and 	001h			;check TxRDY bit 
091b ca 17 09					jp 	z,write_string		;loop if not set 
091e 7e						ld 	a,(hl)			;get char from string 
091f a7						and 	a			;check if 0 
0920 c8						ret 	z			;yes, finished 
0921 d3 02					out 	(2),a			;no, write char to output 
0923 23						inc 	hl			;next char in string 
0924 c3 17 09					jp 	write_string		;start over 
0927			; 
0927			;Binary loader. Receive a binary file, place in memory. 
0927			;Address of load passed in HL, length of load (= file length) in BC 
0927 db 03		bload:			in 	a,(3)			;get status 
0929 e6 02					and 	002h			;check RxRDY bit 
092b ca 27 09					jp 	z,bload			;not ready, loop 
092e db 02					in	a,(2) 
0930 77						ld	(hl),a 
0931 23						inc	hl 
0932 0b						dec	bc			;byte counter 
0933 78						ld	a,b			;need to test BC this way because 
0934 b1						or	c			;dec rp instruction does not change flags 
0935 c2 27 09					jp	nz,bload 
0938 c9						ret 
0939			; 
0939			;Binary dump to port. Send a stream of binary data from memory to serial output 
0939			;Address of dump passed in HL, length of dump in BC 
0939 db 03		bdump:			in 	a,(3)			;get status 
093b e6 01					and 	001h			;check TxRDY bit 
093d ca 39 09					jp 	z,bdump			;not ready, loop 
0940 7e						ld	a,(hl) 
0941 d3 02					out	(2),a 
0943 23						inc	hl 
0944 0b						dec	bc 
0945 78						ld	a,b			;need to test this way because 
0946 b1						or	c			;dec rp instruction does not change flags 
0947 c2 39 09					jp	nz,bdump 
094a c9						ret 
094b			; 
094b			;Subroutine to get a string from serial input, place in buffer. 
094b			;Buffer address passed in HL reg. 
094b			;Uses A,BC,DE,HL registers (including calls to other subroutines). 
094b			;Line entry ends by hitting return key. Return char not included in string (replaced by zero). 
094b			;Backspace editing OK. No error checking. 
094b			; 
094b 0e 00		get_line:		ld	c,000h			;line position 
094d 7c						ld	a,h			;put original buffer address in de 
094e 57						ld	d,a			;after this don't need to preserve hl 
094f 7d						ld	a,l			;subroutines called don't use de 
0950 5f						ld	e,a 
0951 db 03		get_line_next_char:	in 	a,(3)			;get status 
0953 e6 02					and 	002h			;check RxRDY bit 
0955 ca 51 09					jp 	z,get_line_next_char	;not ready, loop 
0958 db 02					in 	a,(2)			;get char 
095a fe 0d					cp	00dh			;check if return 
095c c8						ret	z			;yes, normal exit 
095d fe 7f					cp	07fh			;check if backspace (VT102 keys) 
095f ca 73 09					jp	z,get_line_backspace	;yes, jump to backspace routine 
0962 fe 08					cp	008h			;check if backspace (ANSI keys) 
0964 ca 73 09					jp	z,get_line_backspace	;yes, jump to backspace 
0967 cd 0b 09					call	write_char		;put char on screen 
096a 12						ld	(de),a			;store char in buffer 
096b 13						inc	de			;point to next space in buffer 
096c 0c						inc	c			;inc counter 
096d 3e 00					ld	a,000h 
096f 12						ld	(de),a			;leaves a zero-terminated string in buffer 
0970 c3 51 09					jp	get_line_next_char 
0973 79			get_line_backspace:	ld	a,c			;check current position in line 
0974 fe 00					cp	000h			;at beginning of line? 
0976 ca 51 09					jp	z,get_line_next_char	;yes, ignore backspace, get next char 
0979 1b						dec	de			;no, erase char from buffer 
097a 0d						dec	c			;back up one 
097b 3e 00					ld	a,000h			;put a zero in buffer where the last char was 
097d 12						ld	(de),a 
097e 21 83 0c					ld	hl,erase_char_string	;ANSI sequence to delete one char from line 
0981 cd 17 09					call	write_string		;transmits sequence to backspace and erase char 
0984 c3 51 09					jp	get_line_next_char 
0987			; 
0987			;Creates a two-char hex string from the byte value passed in register A 
0987			;Location to place string passed in HL 
0987			;String is zero-terminated, stored in 3 locations starting at HL 
0987			;Also uses registers b,d, and e 
0987 47			byte_to_hex_string:	ld	b,a			;store original byte 
0988 cb 3f					srl	a			;shift right 4 times, putting 
098a cb 3f					srl	a			;high nybble in low-nybble spot 
098c cb 3f					srl	a			;and zeros in high-nybble spot 
098e cb 3f					srl	a 
0990 16 00					ld	d,000h			;prepare for 16-bit addition 
0992 5f						ld	e,a			;de contains offset 
0993 e5						push	hl			;temporarily store string target address 
0994 21 ed 09					ld	hl,hex_char_table	;use char table to get high-nybble character 
0997 19						add	hl,de			;add offset to start of table 
0998 7e						ld	a,(hl)			;get char 
0999 e1						pop	hl			;get string target address 
099a 77						ld	(hl),a			;store first char of string 
099b 23						inc	hl			;point to next string target address 
099c 78						ld	a,b			;get original byte back from reg b 
099d e6 0f					and	00fh			;mask off high-nybble 
099f 5f						ld	e,a			;d still has 000h, now de has offset 
09a0 e5						push	hl			;temp store string target address 
09a1 21 ed 09					ld	hl,hex_char_table	;start of table 
09a4 19						add	hl,de			;add offset 
09a5 7e						ld	a,(hl)			;get char 
09a6 e1						pop	hl			;get string target address 
09a7 77						ld	(hl),a			;store second char of string 
09a8 23						inc	hl			;point to third location 
09a9 3e 00					ld	a,000h			;zero to terminate string 
09ab 77						ld	(hl),a			;store the zero 
09ac c9						ret				;done 
09ad			; 
09ad			;Converts a single ASCII hex char to a nybble value 
09ad			;Pass char in reg A. Letter numerals must be upper case. 
09ad			;Return nybble value in low-order reg A with zeros in high-order nybble if no error. 
09ad			;Return 0ffh in reg A if error (char not a valid hex numeral). 
09ad			;Also uses b, c, and hl registers. 
09ad 21 ed 09		hex_char_to_nybble:	ld	hl,hex_char_table 
09b0 06 0f					ld	b,00fh			;no. of valid characters in table - 1. 
09b2 0e 00					ld	c,000h			;will be nybble value 
09b4 be			hex_to_nybble_loop:	cp	(hl)			;character match here? 
09b5 ca c1 09					jp	z,hex_to_nybble_ok	;match found, exit 
09b8 05						dec	b			;no match, check if at end of table 
09b9 fa c3 09					jp	m,hex_to_nybble_err	;table limit exceded, exit with error 
09bc 0c						inc	c			;still inside table, continue search 
09bd 23						inc	hl 
09be c3 b4 09					jp	hex_to_nybble_loop 
09c1 79			hex_to_nybble_ok:	ld	a,c			;put nybble value in a 
09c2 c9						ret 
09c3 3e ff		hex_to_nybble_err:	ld	a,0ffh			;error value 
09c5 c9						ret 
09c6			; 
09c6			;Converts a hex character pair to a byte value 
09c6			;Called with location of high-order char in HL 
09c6			;If no error carry flag clear, returns with byte value in register A, and 
09c6			;HL pointing to next mem location after char pair. 
09c6			;If error (non-hex char) carry flag set, HL pointing to invalid char 
09c6 7e			hex_to_byte:		ld	a,(hl)			;location of character pair 
09c7 e5						push	hl			;store hl (hex_char_to_nybble uses it) 
09c8 cd ad 09					call	hex_char_to_nybble 
09cb e1						pop	hl			;returns with nybble value in a reg, or 0ffh if error 
09cc fe ff					cp	0ffh			;non-hex character? 
09ce ca eb 09					jp	z,hex_to_byte_err	;yes, exit with error 
09d1 cb 27					sla	a			;no, move low order nybble to high side 
09d3 cb 27					sla	a 
09d5 cb 27					sla	a 
09d7 cb 27					sla	a 
09d9 57						ld	d,a			;store high-nybble 
09da 23						inc	hl			;get next character of the pair 
09db 7e						ld	a,(hl) 
09dc e5						push	hl			;store hl 
09dd cd ad 09					call	hex_char_to_nybble 
09e0 e1						pop	hl 
09e1 fe ff					cp	0ffh			;non-hex character? 
09e3 ca eb 09					jp	z,hex_to_byte_err	;yes, exit with error 
09e6 b2						or	d			;no, combine with high-nybble 
09e7 23						inc	hl			;point to next memory location after char pair 
09e8 37						scf 
09e9 3f						ccf				;no-error exit (carry = 0) 
09ea c9						ret 
09eb 37			hex_to_byte_err:	scf				;error, carry flag set 
09ec c9						ret 
09ed ..			hex_char_table:		defm	"0123456789ABCDEF"	;ASCII hex table 
09fd			; 
09fd			;Subroutine to get a two-byte address from serial input. 
09fd			;Returns with address value in HL 
09fd			;Uses locations in RAM for buffer and variables 
09fd 21 0b 08		address_entry:		ld	hl,buffer		;location for entered string 
0a00 cd 4b 09					call	get_line		;returns with address string in buffer 
0a03 21 0b 08					ld	hl,buffer		;location of stored address entry string 
0a06 cd c6 09					call	hex_to_byte		;will get high-order byte first 
0a09 da 1f 0a					jp	c, address_entry_error	;if error, jump 
0a0c 32 04 08					ld	(current_location+1),a	;store high-order byte, little-endian 
0a0f 21 0d 08					ld	hl,buffer+2		;point to low-order hex char pair 
0a12 cd c6 09					call	hex_to_byte		;get low-order byte 
0a15 da 1f 0a					jp	c, address_entry_error	;jump if error 
0a18 32 03 08					ld	(current_location),a	;store low-order byte in lower memory 
0a1b 2a 03 08					ld	hl,(current_location)	;put memory address in hl 
0a1e c9						ret 
0a1f 21 c1 0c		address_entry_error:	ld	hl,address_error_msg 
0a22 cd 17 09					call	write_string 
0a25 c3 fd 09					jp	address_entry 
0a28			; 
0a28			;Subroutine to get a decimal string, return a word value 
0a28			;Calls decimal_string_to_word subroutine 
0a28 21 0b 08		decimal_entry:		ld	hl,buffer 
0a2b cd 4b 09					call	get_line		;returns with DE pointing to terminating zero 
0a2e 21 0b 08					ld	hl,buffer 
0a31 cd 3e 0a					call	decimal_string_to_word 
0a34 d0						ret	nc			;no error, return with word in hl 
0a35 21 35 0d					ld	hl,decimal_error_msg	;error, try again 
0a38 cd 17 09					call	write_string 
0a3b c3 28 0a					jp	decimal_entry 
0a3e			; 
0a3e			;Subroutine to convert a decimal string to a word value 
0a3e			;Call with address of string in HL, pointer to end of string in DE 
0a3e			;Carry flag set if error (non-decimal char) 
0a3e			;Carry flag clear, word value in HL if no error. 
0a3e 42			decimal_string_to_word:	ld	b,d 
0a3f 4b						ld	c,e			;use BC as string pointer 
0a40 22 03 08					ld	(current_location),hl	;store addr. of start of buffer in RAM word variable 
0a43 21 00 00					ld	hl,000h			;starting value zero 
0a46 22 09 08					ld	(current_value),hl 
0a49 21 8e 0a					ld	hl,decimal_place_value	;pointer to values 
0a4c 22 07 08					ld	(value_pointer),hl 
0a4f 0b			decimal_next_char:	dec	bc			;next char in string (moving right to left) 
0a50 2a 03 08					ld	hl,(current_location)	;check if at end of decimal string 
0a53 37						scf				;get ready to subtract de from buffer addr. 
0a54 3f						ccf				;set carry to zero (clear) 
0a55 ed 42					sbc	hl,bc			;keep going if bc > or = hl (buffer address) 
0a57 da 63 0a					jp	c,decimal_continue	;borrow means bc > hl 
0a5a ca 63 0a					jp	z,decimal_continue	;z means bc = hl 
0a5d 2a 09 08					ld	hl,(current_value)	;return if de < buffer address (no borrow) 
0a60 37						scf				;get value back from RAM variable 
0a61 3f						ccf 
0a62 c9						ret				;return with carry clear, value in hl 
0a63 0a			decimal_continue:	ld	a,(bc)			;next char in string (right to left) 
0a64 d6 30					sub	030h			;ASCII value of zero char 
0a66 fa 89 0a					jp	m,decimal_error		;error if char value less than 030h 
0a69 fe 0a					cp	00ah			;error if byte value > or = 10 decimal 
0a6b f2 89 0a					jp	p,decimal_error		;a reg now has value of decimal numeral 
0a6e 2a 07 08					ld	hl,(value_pointer)	;get value to add an put in de 
0a71 5e						ld	e,(hl)			;little-endian (low byte in low memory) 
0a72 23						inc	hl 
0a73 56						ld	d,(hl) 
0a74 23						inc	hl			;hl now points to next value 
0a75 22 07 08					ld	(value_pointer),hl 
0a78 2a 09 08					ld	hl,(current_value)	;get back current value 
0a7b 3d			decimal_add:		dec	a			;add loop to increase total value 
0a7c fa 83 0a					jp	m,decimal_add_done	;end of multiplication 
0a7f 19						add	hl,de 
0a80 c3 7b 0a					jp	decimal_add 
0a83 22 09 08		decimal_add_done:	ld	(current_value),hl 
0a86 c3 4f 0a					jp	decimal_next_char 
0a89 37			decimal_error:		scf 
0a8a c9						ret 
0a8b c3 7b 0a					jp	decimal_add 
0a8e 01 00 0a 00 64 00 e8 03 10 27	decimal_place_value:	defw	1,10,100,1000,10000 
0a98			; 
0a98			;Memory dump 
0a98			;Displays a 256-byte block of memory in 16-byte rows. 
0a98			;Called with address of start of block in HL 
0a98 22 03 08		memory_dump:		ld	(current_location),hl	;store address of block to be displayed 
0a9b 3e 00					ld	a,000h 
0a9d 32 06 08					ld	(byte_count),a		;initialize byte count 
0aa0 32 05 08					ld	(line_count),a		;initialize line count 
0aa3 c3 d8 0a					jp	dump_new_line 
0aa6 2a 03 08		dump_next_byte:		ld	hl,(current_location)	;get byte address from storage, 
0aa9 7e						ld	a,(hl)			;get byte to be converted to string 
0aaa 23						inc	hl			;increment address and 
0aab 22 03 08					ld	(current_location),hl	;store back 
0aae 21 0b 08					ld	hl,buffer		;location to store string 
0ab1 cd 87 09					call	byte_to_hex_string	;convert 
0ab4 21 0b 08					ld	hl,buffer		;display string 
0ab7 cd 17 09					call	write_string 
0aba 3a 06 08					ld	a,(byte_count)		;next byte 
0abd 3c						inc	a 
0abe ca 08 0b					jp	z,dump_done		;stop when 256 bytes displayed 
0ac1 32 06 08					ld	(byte_count),a		;not finished yet, store 
0ac4 3a 05 08					ld	a,(line_count)		;end of line (16 characters)? 
0ac7 fe 0f					cp	00fh			;yes, start new line 
0ac9 ca d8 0a					jp	z,dump_new_line 
0acc 3c						inc	a			;no, increment line count 
0acd 32 05 08					ld	(line_count),a 
0ad0 3e 20					ld	a,020h			;print space 
0ad2 cd 0b 09					call	write_char 
0ad5 c3 a6 0a					jp	dump_next_byte		;continue 
